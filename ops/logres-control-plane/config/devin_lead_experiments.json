    "routing": {"metric": "verification_pass_rate", "direction": "higher", "scopes": ["ops/logres-control-plane/lib/logres_devin_lead.py", "ops/logres-control-plane/tests/test_devin_lead.py"]},
    "concurrency": {"metric": "resource_contention", "direction": "lower", "scopes": ["ops/logres-control-plane/lib/logres_capacity.py", "ops/logres-control-plane/tests/test_capacity.py"]},
    "retry_policy": {"metric": "rework_rate", "direction": "lower", "scopes": ["ops/logres-control-plane/lib/logres_swarm.py", "ops/logres-control-plane/tests/test_swarm.py"]},
    "verification_scheduling": {"metric": "queue_age_seconds", "direction": "lower", "scopes": ["ops/logres-control-plane/bin/logres-verify-farm", "ops/logres-control-plane/tests/test_verify_policy.py"]},
