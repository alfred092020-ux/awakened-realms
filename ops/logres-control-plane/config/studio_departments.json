{
  "schema": 1,
  "guardrails": ["brain_ownership", "independent_verification", "protected_branches", "spending_policy", "cross_department_gates"],
  "task_generation_cap_per_cycle": 3,
  "infrastructure_work_ratio_max": 0.35,
  "departments": {
    "executive_production": {"charter":"Arbitrate project priorities from user goals and milestone evidence.","objectives":["critical-path progress","bounded work generation"],"task_types":["planning","coordination"],"owned_artifacts":["mission","roadmap","decisions"],"required_evidence":["Brain task state","milestone status"],"quality_gates":["Brain lease","cross-department review"],"concurrency_budget":1,"engines":["devin","chatgpt"],"lead":"executive_devin","escalation":"user"},
    "game_design": {"charter":"Define evidence-bounded gameplay intent and acceptance contracts.","objectives":["behavioral fidelity","finite specifications"],"task_types":["design","systems","quest"],"owned_artifacts":["design contracts","content rules"],"required_evidence":["historical evidence","acceptance criteria"],"quality_gates":["evidence classification","engineering handoff"],"concurrency_budget":2,"engines":["chatgpt","devin"],"lead":"department_lead","escalation":"executive_production"},
    "gameplay_engineering": {"charter":"Implement field, battle, progression and runtime behavior.","objectives":["playable critical path","test coverage"],"task_types":["implementation","battle","field","gameplay"],"owned_artifacts":["src/game","game tests"],"required_evidence":["changed tests","integration tests"],"quality_gates":["focused tests","build","E2E"],"concurrency_budget":4,"engines":["devin","chatgpt","copilot"],"lead":"department_lead","escalation":"executive_production"},
    "art_ui_ux": {"charter":"Deliver evidence-bounded visual presentation and interaction fidelity.","objectives":["visual fidelity","usable portrait UX"],"task_types":["art","ui","ux","presentation"],"owned_artifacts":["assets","UI scenes","visual references"],"required_evidence":["visual provenance","reference captures"],"quality_gates":["visual truth","device review"],"concurrency_budget":3,"engines":["chatgpt","devin","figma"],"lead":"department_lead","escalation":"executive_production"},
    "qa_test": {"charter":"Independently verify code, behavior, visuals and physical-device release paths.","objectives":["verification pass rate","low regression escape"],"task_types":["qa","test","regression","device"],"owned_artifacts":["verification receipts","device proofs","regressions"],"required_evidence":["exact SHA","test output"],"quality_gates":["independent verification","exact-SHA proof"],"concurrency_budget":3,"engines":["chatgpt","devin","remote-test"],"lead":"department_lead","escalation":"executive_production"},
    "security_integrity": {"charter":"Protect credentials, isolation, governance and provenance boundaries.","objectives":["fail-closed privilege","credential containment"],"task_types":["security","integrity","isolation"],"owned_artifacts":["privilege policy","sandbox","security tests"],"required_evidence":["threat-specific tests","independent review"],"quality_gates":["security review","governed privilege"],"concurrency_budget":2,"engines":["chatgpt","devin"],"lead":"department_lead","escalation":"user"},
    "reverse_engineering_research": {"charter":"Recover lawful historical and version-sensitive evidence without inventing facts.","objectives":["evidence closure","explicit ceilings"],"task_types":["research","reverse","evidence","protocol"],"owned_artifacts":["evidence DB","RE reports","provenance"],"required_evidence":["hashes","source provenance","confidence"],"quality_gates":["historical priority policy","contradiction review"],"concurrency_budget":4,"engines":["research","chatgpt","devin","ghidra"],"lead":"department_lead","escalation":"executive_production"},
    "devops_build_release": {"charter":"Own reproducible builds, deployment, integration and release packaging.","objectives":["clean integration","reproducible release"],"task_types":["devops","build","release","control-plane"],"owned_artifacts":["CI","APK pipeline","deployment manifests"],"required_evidence":["build logs","exact SHA"],"quality_gates":["preflight","release gate"],"concurrency_budget":2,"engines":["devin","chatgpt","remote-build"],"lead":"department_lead","escalation":"executive_production"},
    "performance_telemetry": {"charter":"Measure runtime, CI and studio throughput without weakening correctness.","objectives":["stable budgets","actionable telemetry"],"task_types":["performance","telemetry","metrics"],"owned_artifacts":["budgets","metrics","observations"],"required_evidence":["measured samples","host context"],"quality_gates":["isolated benchmark","trend review"],"concurrency_budget":2,"engines":["devin","chatgpt","remote-test"],"lead":"department_lead","escalation":"executive_production"},
    "knowledge_documentation": {"charter":"Persist decisions, context, documentation and handoffs in durable project memory.","objectives":["restartability","low context loss"],"task_types":["knowledge","documentation","memory"],"owned_artifacts":["Brain memory","docs","handoffs"],"required_evidence":["source links","decision provenance"],"quality_gates":["dedupe","freshness"],"concurrency_budget":2,"engines":["chatgpt","devin"],"lead":"department_lead","escalation":"executive_production"}
  },
  "service_contracts": [
    {"from":"game_design","to":"gameplay_engineering","gate":"acceptance criteria + provenance"},
    {"from":"gameplay_engineering","to":"art_ui_ux","gate":"stable behavior contract"},
    {"from":"art_ui_ux","to":"qa_test","gate":"visual and interaction evidence"},
    {"from":"qa_test","to":"devops_build_release","gate":"independent exact-SHA verification"}
  ]
}
