#!/usr/bin/env python3
import argparse, json, os, sqlite3, sys
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres"))
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_journal import append_event, add_decision, decisions, entity_history, tail
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
def conn():
    c=sqlite3.connect(DB,timeout=30); c.row_factory=sqlite3.Row; c.execute("pragma busy_timeout=30000"); return c
def main():
    p=argparse.ArgumentParser(prog="logres-journal"); s=p.add_subparsers(dest="cmd",required=True)
    a=s.add_parser("append"); a.add_argument("actor"); a.add_argument("entity_type"); a.add_argument("entity_id"); a.add_argument("action"); a.add_argument("--cause",default=""); a.add_argument("--sha"); a.add_argument("--artifact"); a.add_argument("--payload",default="{}"); a.add_argument("--dedupe")
    t=s.add_parser("tail"); t.add_argument("--limit",type=int,default=50)
    h=s.add_parser("entity"); h.add_argument("entity_type"); h.add_argument("entity_id")
    d=s.add_parser("decision"); d.add_argument("actor"); d.add_argument("scope"); d.add_argument("subject"); d.add_argument("selected"); d.add_argument("--why",required=True); d.add_argument("--alternative",action="append",default=[]); d.add_argument("--evidence",action="append",default=[]); d.add_argument("--expected",default=""); d.add_argument("--task"); d.add_argument("--sha")
    dl=s.add_parser("decisions"); dl.add_argument("--scope")
    x=p.parse_args(); c=conn()
    try:
        if x.cmd=="append": out=append_event(c,actor=x.actor,entity_type=x.entity_type,entity_id=x.entity_id,action=x.action,cause=x.cause,sha=x.sha,artifact_path=x.artifact,payload=json.loads(x.payload),dedupe_key=x.dedupe)
        elif x.cmd=="tail": out=tail(c,x.limit)
        elif x.cmd=="entity": out=entity_history(c,x.entity_type,x.entity_id)
        elif x.cmd=="decision": out={"id":add_decision(c,actor=x.actor,scope=x.scope,subject=x.subject,why=x.why,alternatives=x.alternative,selected=x.selected,evidence=x.evidence,expected_outcome=x.expected,task_id=x.task,sha=x.sha)}
        else: out=decisions(c,x.scope)
    finally: c.close()
    print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__": main()
