#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path


FULL_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
INTEGRATION_BRANCH = "feat/logres-reconstruction"
ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
REPO = Path(
    os.environ.get(
        "LOGRES_REPO_ROOT",
        str(ROOT / "src" / "awakened-realms"),
    )
)
STAMP = Path(
    os.environ.get(
        "LOGRES_RUNTIME_DEPLOY_STAMP",
        str(ROOT / "control" / "runtime-deployment.json"),
    )
)


class RuntimeDeployError(RuntimeError):
    pass


def run_command(argv, *, runner=subprocess.run):
    return runner(
        [str(x) for x in argv],
        text=True,
        capture_output=True,
        check=False,
    )


def ensure_exact_sha(value: str) -> str:
    value = value.strip().lower()
    if not FULL_SHA_RE.fullmatch(value):
        raise RuntimeDeployError(
            "deployment requires a full immutable 40-character commit SHA"
        )
    return value
def git_output(repo: Path, *args: str, runner=subprocess.run) -> str:
    proc = run_command(
        ["git", "-C", str(repo), *args],
        runner=runner,
    )
    if proc.returncode:
        detail = (proc.stderr or proc.stdout or "").strip()
        raise RuntimeDeployError(
            f"git {' '.join(args)} failed: {detail}"
        )
    return (proc.stdout or "").strip()


def validate_integration_source(
    repo: Path,
    sha: str,
    *,
    runner=subprocess.run,
) -> str:
    sha = ensure_exact_sha(sha)
    branch = git_output(repo, "branch", "--show-current", runner=runner)
    if branch != INTEGRATION_BRANCH:
        raise RuntimeDeployError(
            f"repository branch is {branch or 'DETACHED'}, "
            f"expected {INTEGRATION_BRANCH}"
        )

    head = git_output(repo, "rev-parse", "HEAD", runner=runner)
    integration = git_output(
        repo,
        "rev-parse",
        INTEGRATION_BRANCH,
        runner=runner,
    )
    if head != sha or integration != sha:
        raise RuntimeDeployError(
            f"source/head mismatch requested={sha} "
            f"head={head} integration={integration}"
        )

    dirty = git_output(repo, "status", "--porcelain", runner=runner)
    if dirty:
        raise RuntimeDeployError(
            "integration worktree is dirty; refusing runtime deployment"
        )
    return sha


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def scheduler_recent(
    path: Path,
    *,
    max_age_seconds: float = 180.0,
    now_epoch: float | None = None,
) -> tuple[bool, float | None]:
    if not path.is_file():
        return False, None
    now_epoch = time.time() if now_epoch is None else now_epoch
    age = max(0.0, now_epoch - path.stat().st_mtime)
    return age <= max_age_seconds, age


def atomic_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        suffix=".tmp",
        dir=path.parent,
    )
    temp = Path(temp_name)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, path)
    finally:
        if temp.exists():
            temp.unlink()
def load_deploy_function(repo: Path):
    deploy_path = repo / "scripts" / "logres" / "deploy_control_plane.py"
    spec = importlib.util.spec_from_file_location(
        "logres_runtime_deploy_manifest",
        deploy_path,
    )
    if spec is None or spec.loader is None:
        raise RuntimeDeployError(
            f"cannot load deployment manifest from {deploy_path}"
        )
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module.deploy


def deploy_runtime(
    repo: Path,
    root: Path,
    sha: str,
    *,
    stamp_path: Path,
    deploy_fn=None,
    runner=subprocess.run,
    scheduler_log_path: Path | None = None,
    scheduler_max_age_seconds: float = 180.0,
    now_epoch: float | None = None,
) -> dict:
    sha = validate_integration_source(repo, sha, runner=runner)
    deploy_fn = deploy_fn or load_deploy_function(repo)
    source_root = repo / "ops" / "logres-control-plane"

    try:
        deployments = deploy_fn(source_root, root, dry_run=False)
    except Exception as exc:
        raise RuntimeDeployError(
            f"control-plane manifest deployment failed: {exc}"
        ) from exc

    files = {}
    for item in deployments:
        source = Path(item.source)
        destination = Path(item.destination)
        if not source.is_file() or not destination.is_file():
            raise RuntimeDeployError(
                f"deployed file missing: {source} -> {destination}"
            )
        source_hash = sha256_file(source)
        destination_hash = sha256_file(destination)
        if source_hash != destination_hash:
            raise RuntimeDeployError(
                f"runtime hash mismatch for {destination}"
            )
        files[str(destination.relative_to(root))] = source_hash

    # The unprivileged user-space supervisor is the authoritative recurring
    # scheduler. It does not depend on setgid crontab behavior, which may be
    # blocked by no_new_privs in hardened automation contexts.
    supervisor = run_command(
        [root / "bin" / "logres-supervisor", "ensure"],
        runner=runner,
    )
    if supervisor.returncode:
        detail = (supervisor.stderr or supervisor.stdout or "").strip()
        raise RuntimeDeployError(
            f"user supervisor failed to start: {detail}"
        )

    # Keep the historical cron as a best-effort bootstrap/fallback. Failure to
    # rewrite it is non-fatal once the authoritative supervisor is healthy.
    cron = run_command(
        [root / "bin" / "logres-autonomy-cron", "install"],
        runner=runner,
    )
    cron_reconciled = cron.returncode == 0
    cron_diagnostic = ""
    scheduler_age_seconds = None
    if not cron_reconciled:
        cron_diagnostic = (
            (cron.stderr or cron.stdout or "").strip()[:800]
        )
        scheduler_log = (
            scheduler_log_path
            if scheduler_log_path is not None
            else root / "logs" / "autonomy-cron.log"
        )
        _, scheduler_age_seconds = scheduler_recent(
            scheduler_log,
            max_age_seconds=scheduler_max_age_seconds,
            now_epoch=now_epoch,
        )

    payload = {
        "schema": 3,
        "integration_sha": sha,
        "deployed_at": datetime.now(timezone.utc).isoformat(
            timespec="seconds"
        ),
        "file_count": len(files),
        "files": files,
        "cron_reconciled": cron_reconciled,
        "cron_diagnostic": cron_diagnostic,
        "scheduler_age_seconds": (
            round(scheduler_age_seconds, 3)
            if scheduler_age_seconds is not None
            else None
        ),
        "scheduler": {
            "authoritative": "logres-supervisor",
            "supervisor": "healthy",
            "legacy_cron": (
                "reconciled" if cron_reconciled else "deferred"
            ),
            "legacy_cron_detail": cron_diagnostic[-500:],
        },
    }
    atomic_json(stamp_path, payload)
    return payload
def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-runtime-deploy")
    parser.add_argument("--sha", required=True)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    try:
        payload = deploy_runtime(
            REPO,
            ROOT,
            args.sha,
            stamp_path=STAMP,
        )
    except RuntimeDeployError as exc:
        print(f"RUNTIME_DEPLOY_REFUSED {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        cron_state = (
            "ok" if payload.get("cron_reconciled") else "degraded-live"
        )
        print(
            "RUNTIME_DEPLOYED "
            f"sha={payload['integration_sha']} "
            f"files={payload['file_count']} "
            f"cron={cron_state} "
            f"stamp={STAMP}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
