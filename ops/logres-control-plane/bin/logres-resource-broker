#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_resource_broker import (
    choose_remote_role,
    infer_task_workload,
    plan_workload,
    score_remote_lanes,
)

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(os.environ.get("LOGRES_CONTROL_DB", str(ROOT / "control/control.sqlite")))
POOL = Path(os.environ.get("LOGRES_REMOTE_POOL_BIN", str(ROOT / "bin/logres-remote-pool")))
ARTIFACTS = Path(
    os.environ.get(
        "LOGRES_REMOTE_POOL_ARTIFACT_ROOT",
        str(ROOT / "artifacts/remote-pool"),
    )
)


def health_rows() -> list[dict]:
    proc = subprocess.run(
        [str(POOL), "status", "--json"],
        text=True,
        capture_output=True,
        check=False,
        timeout=30,
    )
    if proc.returncode:
        return []
    try:
        value = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return []
    return value if isinstance(value, list) else []


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-resource-broker")
    sub = ap.add_subparsers(dest="command", required=True)

    remote = sub.add_parser("remote-role")
    remote.add_argument("npm_script", nargs="?", default="test")
    remote.add_argument("--json", action="store_true")

    plan = sub.add_parser("plan")
    plan.add_argument("--workload", default="verification")
    plan.add_argument("--script", default="test")
    plan.add_argument("--sensitivity", default="normal")

    task = sub.add_parser("task")
    task.add_argument("task_id")

    args = ap.parse_args()

    if args.command == "remote-role":
        health = health_rows()
        try:
            role = choose_remote_role(
                health,
                ARTIFACTS,
                npm_script=args.npm_script,
            )
        except RuntimeError as exc:
            if args.json:
                print(json.dumps({"role": None, "error": str(exc)}))
            else:
                print(str(exc), file=sys.stderr)
            return 1
        if args.json:
            print(
                json.dumps(
                    {
                        "role": role,
                        "script": args.npm_script,
                        "lanes": [
                            lane.to_dict()
                            for lane in score_remote_lanes(
                                health,
                                ARTIFACTS,
                                npm_script=args.npm_script,
                            )
                        ],
                    },
                    indent=2,
                    sort_keys=True,
                )
            )
        else:
            print(role)
        return 0

    if args.command == "task":
        conn = sqlite3.connect(DB)
        workload, sensitivity = infer_task_workload(conn, args.task_id)
        conn.close()
    else:
        workload = args.workload
        sensitivity = args.sensitivity

    health = (
        health_rows()
        if workload in {"verification", "test", "build"}
        else []
    )
    payload = plan_workload(
        workload=workload,
        health_rows=health,
        artifact_root=ARTIFACTS,
        npm_script=getattr(args, "script", "test"),
        sensitivity=sensitivity,
    )
    print(json.dumps(payload.to_dict(), indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
