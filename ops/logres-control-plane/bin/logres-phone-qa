#!/usr/bin/env bash
set -euo pipefail

PHONE_USER="u0_a452"
PHONE_HOST="127.0.0.1"
PHONE_SSH_PORT="${LOGRES_PHONE_SSH_PORT:-}"
if [[ -z "$PHONE_SSH_PORT" ]]; then
  if ss -lnt | grep -q '127.0.0.1:22023'; then
    PHONE_SSH_PORT="22023"
  else
    PHONE_SSH_PORT="${LOGRES_PHONE_SSH_PORT:-22023}"
  fi
fi
KEY="${LOGRES_PHONE_QA_KEY:-/home/ubuntu/logres/control/android-device/qa_controller_ed25519}"
QA_LOCK="${LOGRES_PHONE_QA_LOCK_PATH:-/tmp/logres-phone-hardware-qa.lock}"
MUTATION_LOCK_FD=""
SSH=(ssh -p "$PHONE_SSH_PORT" -i "$KEY" -o BatchMode=yes -o ConnectTimeout=8 "$PHONE_USER@$PHONE_HOST")
SCP=(scp -P "$PHONE_SSH_PORT" -i "$KEY" -o BatchMode=yes)

phone() { "${SSH[@]}" "$@"; }

owner_fd_valid() {
  local fd="${LOGRES_PHONE_QA_LOCK_FD:-}"
  [[ "$fd" =~ ^[0-9]+$ ]] || return 1
  [[ -e "/proc/$$/fd/$fd" ]] || return 1
  [[ "$(stat -Lc '%d:%i' "$QA_LOCK" 2>/dev/null || true)" == "$(stat -Lc '%d:%i' "/proc/$$/fd/$fd" 2>/dev/null || true)" ]] || return 1
  flock -n "$fd" >/dev/null 2>&1
}

acquire_mutation_rights() {
  mkdir -p "$(dirname "$QA_LOCK")"
  touch "$QA_LOCK"
  if owner_fd_valid; then
    return 0
  fi
  exec {MUTATION_LOCK_FD}<>"$QA_LOCK"
  if ! flock -n "$MUTATION_LOCK_FD"; then
    echo "PHONE_QA_BUSY: hardware QA owns the phone mutation lock" >&2
    exit 75
  fi
}

shell_is_read_only() {
  local command="$1"
  case "$command" in
    "uiautomator dump /sdcard/logres-chat-bridge.xml >/dev/null 2>&1; cat /sdcard/logres-chat-bridge.xml") return 0 ;;
    "dumpsys activity activities | grep -m1 -E 'topResumedActivity=|mResumedActivity=' || true") return 0 ;;
  esac
  if [[ "$command" == *';'* || "$command" == *'|'* || "$command" == *'>'* || "$command" == *'<'* || "$command" == *'&'* ]]; then
    return 1
  fi
  case "$command" in
    getprop|"getprop "*|dumpsys|"dumpsys "*|pidof|"pidof "*|ps|"ps "*|"wm size"|"wm density"|"settings get "*|"cmd display get-user-preferred-display-mode"*) return 0 ;;
    *) return 1 ;;
  esac
}

discover_port() {
  phone 'python - <<'"'"'PY'"'"'
import socket,struct,time
def enc(n):
    o=b""
    for p in n.rstrip(".").split("."):
        b=p.encode();o+=bytes([len(b)])+b
    return o+b"\0"
def rn(d,o):
    L=[];e=o;j=False;s=set()
    while 1:
        if o>=len(d): return ".".join(L),e
        l=d[o]
        if l==0:
            if not j:e=o+1
            return ".".join(L),e
        if l&0xc0==0xc0:
            p=((l&63)<<8)|d[o+1]
            if not j:e=o+2
            if p in s:return ".".join(L),e
            s.add(p);o=p;j=True;continue
        o+=1;L.append(d[o:o+l].decode(errors="ignore"));o+=l
        if not j:e=o
q="_adb-tls-connect._tcp.local."
pkt=struct.pack("!HHHHHH",0,0,1,0,0,0)+enc(q)+struct.pack("!HH",12,0x8001)
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM,socket.IPPROTO_UDP);s.settimeout(1)
s.sendto(pkt,("224.0.0.251",5353));ports=[];end=time.time()+3
while time.time()<end:
    try:d,a=s.recvfrom(65535)
    except socket.timeout:break
    if len(d)<12:continue
    _,_,qd,an,ns,ar=struct.unpack("!HHHHHH",d[:12]);o=12
    for _ in range(qd):_,o=rn(d,o);o+=4
    for count in (an,ns,ar):
        for _ in range(count):
            _,o=rn(d,o)
            if o+10>len(d):break
            typ,cl,ttl,rl=struct.unpack("!HHIH",d[o:o+10]);o+=10
            if typ==33 and rl>=6:
                _,_,p=struct.unpack("!HHH",d[o:o+6]);ports.append(p)
            o+=rl
print(ports[-1] if ports else "")
PY'
}

ensure_adb() {
  local port target
  port="$(discover_port)"
  [[ -n "$port" ]] || { echo "No _adb-tls-connect service discovered" >&2; return 2; }
  phone "adb connect 127.0.0.1:$port >/dev/null 2>&1 || true"
  target="$(phone 'adb devices | awk "/127.0.0.1:/ && /device/{print \$1; exit}"' | tr -d '\r')"
  [[ -n "$target" ]] || { echo "ADB not connected after discovery port=$port" >&2; return 3; }
  printf '%s\n' "$target"
}

case "${1:-status}" in
  status)
    echo "ssh=ok"
    T="$(ensure_adb)"
    echo "adb=$T"
    phone "adb -s '$T' shell getprop ro.product.model; adb -s '$T' shell getprop ro.build.version.release"
    ;;
  shell)
    shift
    COMMAND="$*"
    if ! shell_is_read_only "$COMMAND"; then
      acquire_mutation_rights
    fi
    T="$(ensure_adb)"
    phone "adb -s '$T' shell $COMMAND"
    ;;
  screenshot)
    OUT="${2:?output path required}"
    T="$(ensure_adb)"
    phone "adb -s '$T' exec-out screencap -p" > "$OUT"
    ;;
  install)
    acquire_mutation_rights
    APK="${2:?apk path required}"
    "${SCP[@]}" "$APK" "$PHONE_USER@$PHONE_HOST:/data/data/com.termux/files/home/logres-install.apk"
    T="$(ensure_adb)"
    phone "adb -s '$T' install -r /data/data/com.termux/files/home/logres-install.apk"
    ;;
  logcat)
    OUT="${2:?output path required}"
    T="$(ensure_adb)"
    phone "adb -s '$T' logcat -d -v threadtime" > "$OUT"
    ;;
  *)
    echo "usage: $0 {status|shell <cmd>|screenshot <out>|install <apk>|logcat <out>}" >&2
    exit 64
    ;;
esac
