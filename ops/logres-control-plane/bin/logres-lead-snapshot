#!/usr/bin/env bash
set -euo pipefail
ROOT="${LOGRES_ROOT:-/home/ubuntu/logres}"
LANE_LOCK="${LOGRES_MAINTENANCE_LANE_LOCK:-/tmp/logres-maintenance-lane.lock}"
LOCK="${LOGRES_LEAD_SNAPSHOT_LOCK:-/tmp/logres-lead-snapshot.lock}"
exec 8>"$LANE_LOCK"
flock -n 8 || exit 0
exec 9>"$LOCK"
flock -n 9 || exit 0
mkdir -p "$ROOT/control" "$ROOT/index"
"$ROOT/bin/logres-code-index" >"$ROOT/index/code-index.log" 2>&1 || true
"$ROOT/bin/logres-control" refresh >"$ROOT/control/LEAD_SNAPSHOT.txt.tmp"
mv "$ROOT/control/LEAD_SNAPSHOT.txt.tmp" "$ROOT/control/LEAD_SNAPSHOT.txt"
"$ROOT/bin/logres-lead-json" >"$ROOT/control/LEAD_SNAPSHOT.json.tmp"
mv "$ROOT/control/LEAD_SNAPSHOT.json.tmp" "$ROOT/control/LEAD_SNAPSHOT.json"
"$ROOT/bin/logres-worktree-audit" >"$ROOT/control/WORKTREE_AUDIT.txt.tmp"
mv "$ROOT/control/WORKTREE_AUDIT.txt.tmp" "$ROOT/control/WORKTREE_AUDIT.txt"
"$ROOT/bin/logres-branch-sweep" >"$ROOT/control/BRANCH_SWEEP.txt.tmp"
mv "$ROOT/control/BRANCH_SWEEP.txt.tmp" "$ROOT/control/BRANCH_SWEEP.txt"
"$ROOT/bin/logres-branch-archaeology" >"$ROOT/control/BRANCH_ARCHAEOLOGY.txt.tmp"
mv "$ROOT/control/BRANCH_ARCHAEOLOGY.txt.tmp" "$ROOT/control/BRANCH_ARCHAEOLOGY.txt"
"$ROOT/bin/logres-integration-review" >"$ROOT/control/INTEGRATION_REVIEW.txt.tmp"
mv "$ROOT/control/INTEGRATION_REVIEW.txt.tmp" "$ROOT/control/INTEGRATION_REVIEW.txt"
"$ROOT/bin/logres-coordinator" plan >"$ROOT/control/COORDINATION_PLAN.txt.tmp"
mv "$ROOT/control/COORDINATION_PLAN.txt.tmp" "$ROOT/control/COORDINATION_PLAN.txt"
"$ROOT/bin/logres-coordinator" wave --count 5 >"$ROOT/control/WORK_WAVE.txt.tmp"
mv "$ROOT/control/WORK_WAVE.txt.tmp" "$ROOT/control/WORK_WAVE.txt"
"$ROOT/bin/logres-throughput" >"$ROOT/control/THROUGHPUT.txt.tmp"
mv "$ROOT/control/THROUGHPUT.txt.tmp" "$ROOT/control/THROUGHPUT.txt"
"$ROOT/bin/logres-throughput" --json >"$ROOT/control/THROUGHPUT.json.tmp"
mv "$ROOT/control/THROUGHPUT.json.tmp" "$ROOT/control/THROUGHPUT.json"
"$ROOT/bin/logres-merge-train" status >"$ROOT/control/MERGE_TRAIN.txt.tmp"
mv "$ROOT/control/MERGE_TRAIN.txt.tmp" "$ROOT/control/MERGE_TRAIN.txt"
"$ROOT/bin/logres-merge-preflight" status >"$ROOT/control/MERGE_PREFLIGHT.txt.tmp"
mv "$ROOT/control/MERGE_PREFLIGHT.txt.tmp" "$ROOT/control/MERGE_PREFLIGHT.txt"
"$ROOT/bin/logres-integration-pager" >/dev/null 2>&1 || true
date -Is >"$ROOT/control/LEAD_SNAPSHOT.updated"
