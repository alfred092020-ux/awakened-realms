#!/usr/bin/env bash
set -euo pipefail
ROOT="${LOGRES_ROOT:-/home/ubuntu/logres}"
LANE_LOCK="${LOGRES_MAINTENANCE_LANE_LOCK:-/tmp/logres-maintenance-lane.lock}"
LOCK="${LOGRES_LEAD_SNAPSHOT_LOCK:-/tmp/logres-lead-snapshot.lock}"
exec 8>"$LANE_LOCK"
flock -n 8 || exit 0
exec 9>"$LOCK"
flock -n 9 || exit 0
mkdir -p "$ROOT/control" "$ROOT/index"

atomic_capture() {
  local out="$1"
  shift
  local dir base tmp rc
  dir="$(dirname "$out")"
  base="$(basename "$out")"
  tmp="$(mktemp "$dir/.${base}.tmp.XXXXXX")"
  if "$@" >"$tmp"; then
    mv -f "$tmp" "$out"
    return 0
  else
    rc=$?
    rm -f "$tmp"
    return "$rc"
  fi
}

"$ROOT/bin/logres-code-index" >"$ROOT/index/code-index.log" 2>&1 || true
atomic_capture "$ROOT/control/LEAD_SNAPSHOT.txt" "$ROOT/bin/logres-control" refresh
atomic_capture "$ROOT/control/LEAD_SNAPSHOT.json" "$ROOT/bin/logres-lead-json"
atomic_capture "$ROOT/control/WORKTREE_AUDIT.txt" "$ROOT/bin/logres-worktree-audit"
atomic_capture "$ROOT/control/BRANCH_SWEEP.txt" "$ROOT/bin/logres-branch-sweep"
atomic_capture "$ROOT/control/BRANCH_ARCHAEOLOGY.txt" "$ROOT/bin/logres-branch-archaeology"
atomic_capture "$ROOT/control/INTEGRATION_REVIEW.txt" "$ROOT/bin/logres-integration-review"
atomic_capture "$ROOT/control/COORDINATION_PLAN.txt" "$ROOT/bin/logres-coordinator" plan
atomic_capture "$ROOT/control/WORK_WAVE.txt" "$ROOT/bin/logres-coordinator" wave --count 5
atomic_capture "$ROOT/control/THROUGHPUT.txt" "$ROOT/bin/logres-throughput"
atomic_capture "$ROOT/control/THROUGHPUT.json" "$ROOT/bin/logres-throughput" --json
atomic_capture "$ROOT/control/MERGE_TRAIN.txt" "$ROOT/bin/logres-merge-train" status
atomic_capture "$ROOT/control/MERGE_PREFLIGHT.txt" "$ROOT/bin/logres-merge-preflight" status
"$ROOT/bin/logres-integration-pager" >/dev/null 2>&1 || true
date -Is >"$ROOT/control/LEAD_SNAPSHOT.updated"
