#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
from dataclasses import asdict
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
LIB_DIR = CONTROL_ROOT / "lib"
sys.path.insert(0, str(LIB_DIR))

from logres_copilot import SubprocessCommandRunner, SubprocessGitHubRunner
from logres_reconcile import (
    SQLiteAICache,
    format_routes_status,
    reconcile_routes,
    route_status,
)
from logres_route_store import ensure_route_schema


DEFAULT_DB = Path("/home/ubuntu/logres/control/control.sqlite")
DEFAULT_CONFIG = Path("/home/ubuntu/logres/control/autoflow.json")
DEFAULT_CONFIG_FALLBACK = CONTROL_ROOT / "config" / "autoflow.default.json"
DEFAULT_REPO = Path("/home/ubuntu/logres/src/awakened-realms")


def load_config() -> dict:
    configured = Path(os.environ.get("LOGRES_AUTOFLOW_CONFIG", str(DEFAULT_CONFIG)))
    source = configured if configured.is_file() else DEFAULT_CONFIG_FALLBACK
    if not source.is_file():
        return {}
    loaded = json.loads(source.read_text())
    if not isinstance(loaded, dict):
        raise ValueError("autoflow config must be a JSON object")
    return loaded


def integration_sha() -> str:
    forced = os.environ.get("LOGRES_INTEGRATION_SHA", "").strip()
    if forced:
        return forced
    result = subprocess.run(
        [
            "git", "-C", str(DEFAULT_REPO),
            "rev-parse", "origin/feat/logres-reconstruction",
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-route-reconcile")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--status", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--db",
        type=Path,
        default=Path(os.environ.get("LOGRES_CONTROL_DB", str(DEFAULT_DB))),
    )
    args = parser.parse_args()

    config = load_config()
    conn = sqlite3.connect(args.db)
    conn.row_factory = sqlite3.Row
    ensure_route_schema(conn)

    if args.status or args.dry_run:
        status = route_status(conn, config)
        if args.json:
            print(json.dumps(asdict(status), sort_keys=True))
        else:
            print(format_routes_status(status))
        conn.close()
        return 0

    results = reconcile_routes(
        conn,
        ai_cache=SQLiteAICache(),
        github=SubprocessGitHubRunner(),
        command_runner=SubprocessCommandRunner(),
        config=config,
        current_integration_sha=integration_sha(),
    )
    status = route_status(conn, config)
    conn.close()

    if args.json:
        print(
            json.dumps(
                {
                    "recovered": [asdict(item) for item in results],
                    "status": asdict(status),
                },
                sort_keys=True,
            )
        )
    else:
        print(f"reconciled_routes={len(results)}")
        print(format_routes_status(status))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
