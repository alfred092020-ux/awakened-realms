#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_knowledge import refresh_graph
from logres_optimizer import record_swarm_observations, score_ready_tasks

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(os.environ.get("LOGRES_CONTROL_DB", str(ROOT / "control/control.sqlite")))


def connect():
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    return conn


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-optimizer")
    sub = ap.add_subparsers(dest="command", required=True)
    p = sub.add_parser("plan")
    p.add_argument("--limit", type=int, default=12)
    p.add_argument("--work-type", action="append", default=[])
    sub.add_parser("observe")
    args = ap.parse_args()

    conn = connect()
    refresh_graph(conn)
    observed = record_swarm_observations(conn)
    if args.command == "observe":
        out = {"observations_added": observed}
    else:
        filter_set = set(args.work_type) if args.work_type else None
        out = {
            "observations_added": observed,
            "tasks": [
                item.to_dict()
                for item in score_ready_tasks(
                    conn,
                    work_type_filter=filter_set,
                )[: max(1, args.limit)]
            ],
        }
    conn.close()
    print(json.dumps(out, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
