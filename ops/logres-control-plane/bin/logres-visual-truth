#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from logres_visual_truth import (
    durable_record,
    ensure_schema,
    flush_spool,
    history,
    latest,
    regressions,
)

DB = Path(os.environ.get("LOGRES_CONTROL_DB", ROOT / "control/control.sqlite"))
SPOOL = Path(
    os.environ.get(
        "LOGRES_VISUAL_TRUTH_SPOOL_DIR",
        ROOT / "control" / "visual-truth-spool",
    )
)


def db_timeout_seconds() -> float:
    raw = os.environ.get("LOGRES_VISUAL_TRUTH_DB_TIMEOUT_SECONDS", "4")
    try:
        value = float(raw)
    except ValueError as exc:
        raise ValueError(
            "LOGRES_VISUAL_TRUTH_DB_TIMEOUT_SECONDS must be numeric"
        ) from exc
    if value <= 0 or value > 15:
        raise ValueError(
            "LOGRES_VISUAL_TRUTH_DB_TIMEOUT_SECONDS must be > 0 and <= 15"
        )
    return value


def connect_db() -> sqlite3.Connection:
    timeout = db_timeout_seconds()
    conn = sqlite3.connect(DB, timeout=timeout)
    conn.row_factory = sqlite3.Row
    conn.execute(f"pragma busy_timeout={int(timeout * 1000)}")
    return conn


def main() -> None:
    parser = argparse.ArgumentParser(prog="logres-visual-truth")
    sub = parser.add_subparsers(dest="cmd", required=True)

    rec = sub.add_parser("record")
    rec.add_argument("sha")
    rec.add_argument("checkpoint")
    rec.add_argument("observed")
    rec.add_argument("verdict")
    rec.add_argument("--reference")
    rec.add_argument("--objective")
    rec.add_argument("--viewport", default="{}")
    rec.add_argument("--device", default="{}")
    rec.add_argument("--metrics", default="{}")

    latest_parser = sub.add_parser("latest")
    latest_parser.add_argument("checkpoint", nargs="?")

    history_parser = sub.add_parser("history")
    history_parser.add_argument("checkpoint")

    sub.add_parser("regressions")
    sub.add_parser("init")
    sub.add_parser("flush")

    args = parser.parse_args()
    conn = connect_db()
    try:
        if args.cmd == "init":
            ensure_schema(conn)
            out = {
                "initialized": True,
                "spool": flush_spool(conn, SPOOL),
            }
        elif args.cmd == "record":
            # Keep old evidence moving without consuming the full current-record
            # lock budget. Required current evidence then gets the normal DB
            # timeout and falls back to an atomic durable spool on contention.
            flush_spool(conn, SPOOL, busy_timeout_ms=50)
            out = durable_record(
                conn,
                SPOOL,
                sha=args.sha,
                checkpoint=args.checkpoint,
                observed_artifact=args.observed,
                verdict=args.verdict,
                reference_artifact=args.reference,
                objective_id=args.objective,
                viewport=json.loads(args.viewport),
                device=json.loads(args.device),
                metrics=json.loads(args.metrics),
            )
        elif args.cmd == "flush":
            out = flush_spool(
                conn,
                SPOOL,
                busy_timeout_ms=int(db_timeout_seconds() * 1000),
            )
        elif args.cmd == "latest":
            flush_spool(conn, SPOOL, busy_timeout_ms=50)
            out = latest(conn, args.checkpoint)
        elif args.cmd == "history":
            flush_spool(conn, SPOOL, busy_timeout_ms=50)
            out = history(conn, args.checkpoint)
        else:
            flush_spool(conn, SPOOL, busy_timeout_ms=50)
            out = regressions(conn)
    finally:
        conn.close()

    print(json.dumps(out, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
