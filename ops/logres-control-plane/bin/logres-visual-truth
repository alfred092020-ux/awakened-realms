#!/usr/bin/env python3
import argparse,json,os,sqlite3,sys
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres")); sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_visual_truth import history,latest,record,regressions
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
def main():
 p=argparse.ArgumentParser(prog="logres-visual-truth"); s=p.add_subparsers(dest="cmd",required=True)
 r=s.add_parser("record"); r.add_argument("sha"); r.add_argument("checkpoint"); r.add_argument("observed"); r.add_argument("verdict"); r.add_argument("--reference"); r.add_argument("--objective"); r.add_argument("--viewport",default="{}"); r.add_argument("--device",default="{}"); r.add_argument("--metrics",default="{}")
 l=s.add_parser("latest"); l.add_argument("checkpoint",nargs="?")
 h=s.add_parser("history"); h.add_argument("checkpoint"); s.add_parser("regressions")
 a=p.parse_args(); c=sqlite3.connect(DB,timeout=30); c.row_factory=sqlite3.Row; c.execute("pragma busy_timeout=30000")
 try:
  if a.cmd=="record": out={"id":record(c,sha=a.sha,checkpoint=a.checkpoint,observed_artifact=a.observed,verdict=a.verdict,reference_artifact=a.reference,objective_id=a.objective,viewport=json.loads(a.viewport),device=json.loads(a.device),metrics=json.loads(a.metrics))}
  elif a.cmd=="latest": out=latest(c,a.checkpoint)
  elif a.cmd=="history": out=history(c,a.checkpoint)
  else: out=regressions(c)
 finally:c.close()
 print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__":main()
