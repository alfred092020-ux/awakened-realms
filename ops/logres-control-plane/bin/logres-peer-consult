#!/usr/bin/env python3
import argparse, json, os, sqlite3, sys
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres"))
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_peer_consultation import consult,history,load_config,ensure_schema
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
CFG=Path(os.environ.get("LOGRES_PEER_CONSULT_CONFIG",Path(__file__).resolve().parents[1]/"config"/"peer_consultation.json"))
def main():
    p=argparse.ArgumentParser(prog="logres-peer-consult")
    p.add_argument("--request",help="path to JSON consultation request; '-' reads stdin")
    p.add_argument("--history",action="store_true")
    p.add_argument("--limit",type=int,default=50)
    a=p.parse_args()
    c=sqlite3.connect(DB,timeout=30); c.row_factory=sqlite3.Row; c.execute("pragma busy_timeout=30000")
    try:
        ensure_schema(c)
        if a.history:
            out={"consultations":history(c,limit=a.limit)}
        else:
            raw=sys.stdin.read() if a.request=="-" else Path(a.request).read_text()
            out=consult(c,json.loads(raw),config=load_config(CFG))
    finally:
        c.close()
    print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__": main()
