#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from logres_memory_intelligence import build_context_packet, ensure_schema

DB = Path(os.environ.get("LOGRES_CONTROL_DB", ROOT / "control/control.sqlite"))


def resolve_task(c: sqlite3.Connection, chat_id: str | None, task_id: str | None) -> str:
    if task_id:
        return task_id
    if not chat_id:
        raise ValueError("provide task_id or --chat")
    row = c.execute(
        "select task_id from brain_task_leases where chat_id=? order by rowid desc limit 1",
        (chat_id,),
    ).fetchone()
    if not row:
        raise ValueError(f"no active task lease for chat: {chat_id}")
    return row[0]


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-context-pack")
    ap.add_argument("task_id", nargs="?")
    ap.add_argument("--chat")
    ap.add_argument("--fact-limit", type=int, default=20)
    ap.add_argument("--knowledge-limit", type=int, default=12)
    ap.add_argument("--transcript-limit", type=int, default=12)
    args = ap.parse_args()

    c = sqlite3.connect(DB, timeout=30)
    c.row_factory = sqlite3.Row
    c.execute("pragma busy_timeout=30000")
    ensure_schema(c)
    try:
        task_id = resolve_task(c, args.chat, args.task_id)
        out = build_context_packet(
            c,
            task_id,
            fact_limit=max(1, min(args.fact_limit, 50)),
            knowledge_limit=max(1, min(args.knowledge_limit, 30)),
            transcript_limit=max(1, min(args.transcript_limit, 24)),
        )
    finally:
        c.close()
    print(json.dumps(out, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
