#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_experiment_executor import (
    AUTHORITY,
    next_shadow_experiment,
    run_shadow_experiment,
)
from logres_governor import ensure_schema

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(os.environ.get("LOGRES_CONTROL_DB", str(ROOT / "control/control.sqlite")))


def connect() -> sqlite3.Connection:
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    ensure_schema(conn)
    return conn


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-experiment-executor")
    sub = ap.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run")
    run.add_argument("experiment_id", type=int)
    sub.add_parser("next")
    args = ap.parse_args()

    conn = connect()
    try:
        experiment_id = (
            args.experiment_id
            if args.command == "run"
            else next_shadow_experiment(conn)
        )
        if experiment_id is None:
            payload = {
                "status": "IDLE",
                "authority": AUTHORITY,
                "reason": "no executable shadow experiment",
            }
        else:
            payload = run_shadow_experiment(conn, experiment_id)
            payload["status"] = "EVALUATED"
    except (ValueError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    finally:
        conn.close()

    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
