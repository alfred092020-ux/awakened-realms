def load_json(path: Path) -> dict:
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def connect() -> sqlite3.Connection:
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    ensure_schema(conn)
    return conn


def run(argv, *, timeout: int | None = None):
    return subprocess.run(
        [str(x) for x in argv],
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
    )


def nexus_tool(name: str, payload: dict, *, timeout: int = 60):
    return run(
        [NEXUS, "tool", name, json.dumps(payload, separators=(",", ":"))],
        timeout=timeout,
    )


def cleanup_devin_isolation(worker: str, task_id: str, branch: str) -> dict:
    identity = {"chatId": worker, "taskId": task_id, "branch": branch}
    stop = nexus_tool("nexus_logres_devin_transient_stop", identity, timeout=30)
    network = nexus_tool("nexus_logres_devin_network_teardown", identity, timeout=60)
    return {
        "service_stopped": stop.returncode == 0,
        "network_torn_down": network.returncode == 0,
    }


def worktree_for_branch(branch: str) -> Path | None:
    if not branch:
        return None
    base = ROOT / "src/awakened-realms"
    proc = run(["git", "-C", base, "worktree", "list", "--porcelain"])
    if proc.returncode:
        return None
    current = None
    target = f"refs/heads/{branch}"
    for line in (proc.stdout or "").splitlines():
        if line.startswith("worktree "):
            current = Path(line.split(" ", 1)[1])
        elif line == f"branch {target}" and current is not None:
            return current
    return None


def clean_stale_patch_worktree(branch: str) -> bool:
    worktree = worktree_for_branch(branch)
    if worktree is None or not worktree.is_dir():
        return False
    reset = run(["git", "-C", worktree, "reset", "--hard", "HEAD"], timeout=60)
    clean = run(["git", "-C", worktree, "clean", "-fd"], timeout=60)
    return reset.returncode == 0 and clean.returncode == 0


def release_stale(conn: sqlite3.Connection, stale_ids: list[int]) -> list[dict]:
    released = []
    for job_id in stale_ids:
        row = conn.execute(
            "select task_id,worker_id,engine,branch,session_id from swarm_jobs where id=?",
            (job_id,),
        ).fetchone()
        if not row:
            continue
        if str(row["engine"] or "") == "devin":
            branch = str(row["branch"] or "").strip()
            session_id = str(row["session_id"] or "").strip()
            if branch and session_id.startswith("systemd:"):
                cleanup_devin_isolation(
                    str(row["worker_id"]), str(row["task_id"]), branch
                )
        lease = conn.execute(
            "select 1 from brain_task_leases where task_id=? and chat_id=?",
            (row["task_id"], row["worker_id"]),
        ).fetchone()
        if lease:
            if str(row["engine"] or "") == "openai-patch":
                branch_row = conn.execute(
                    "select branch from brain_task_leases "
                    "where task_id=? and chat_id=?",
                    (row["task_id"], row["worker_id"]),
                ).fetchone()
                if branch_row and branch_row["branch"]:
                    clean_stale_patch_worktree(str(branch_row["branch"]))
            run([str(ROOT / "bin/logres-control"), "release", row["task_id"]])
            run(
                [
                    BRAIN,
                    "release",
                    row["worker_id"],
                    row["task_id"],
                    "--status",
                    "READY",
                    "--note",
                    "Swarm worker process exited unexpectedly; stale lease recovered.",
                ]
            )
            released.append(
                {
                    "job_id": job_id,
                    "task_id": row["task_id"],
                    "worker_id": row["worker_id"],
                }
            )
    return released


def post_once(subject: str, body: str, dedupe: str, task: str | None = None):
    cmd = [
        BRAIN,
        "post",
        "system",
        "ALL",
        "INFO",
        "NORMAL",
        subject,
        "--body",
        body,
        "--dedupe",
        dedupe,
    ]
    if task:
        cmd += ["--task", task]
    run(cmd)


def dispatch_research(
    conn: sqlite3.Connection,
    cfg: dict,
    *,
    limit: int,
) -> list[dict]:
    if limit <= 0:
        return []
    workers = available_worker_ids(conn, cfg)
    if not workers:
        return []

    swarm_cfg = cfg.get("swarm", {})
    model = str(
        swarm_cfg.get("research_model")
        or cfg.get("openai", {}).get("auto_model")
        or "gpt-5.6-luna"
    )
    max_attempts = int(swarm_cfg.get("research_max_attempts", 2) or 2)

    candidates = select_research_tasks(
        conn,
        min(limit, len(workers)) * 3,
    )
    dispatched = []
    for task in candidates:
        if len(dispatched) >= min(limit, len(workers)):
            break
        task_id = task["id"]
        failures = prior_failures(conn, task_id)
        if failures >= max_attempts:
            post_once(
                f"Swarm research retry ceiling: {task_id}",
                (
                    f"Automatic research failed {failures} time(s); "
                    "leaving task READY for manual/Lead review instead of looping."
                ),
                f"swarm-retry-ceiling:{task_id}:{failures}",
                task_id,
            )
            continue

        budget = budget_state(
            conn,
            cfg,
            int(task.get("priority") or 9),
            model,
        )
        if not automatic_api_allowed(
            budget,
            int(task.get("priority") or 9),
        ):
            continue

        worker = workers[len(dispatched)]
        register_worker(ROOT, worker)
        branch = acquire_task(ROOT, worker, task_id)
        if not branch:
            continue

        try:
            job_id = create_job(
                conn,
                task_id,
                worker,
                "research",
            )
        except sqlite3.IntegrityError:
            run(
                [
                    BRAIN,
                    "release",
                    worker,
                    task_id,
                    "--status",
                    "READY",
                    "--note",
                    "Duplicate live swarm job detected; released safely.",
                ]
            )
            continue

        LOGS.mkdir(parents=True, exist_ok=True)
        log_path = LOGS / f"{job_id}-{task_id}.log"
        log_handle = open(log_path, "ab", buffering=0)
        proc = subprocess.Popen(
            [
                RESEARCH,
                "--task",
                task_id,
                "--worker",
                worker,
                "--job-id",
                str(job_id),
            ],
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
        )
        log_handle.close()
        mark_job_running(conn, job_id, proc.pid)
        dispatched.append(
            {
                "task_id": task_id,
                "worker_id": worker,
                "job_id": job_id,
                "pid": proc.pid,
                "branch": branch,
                "log": str(log_path),
                "budget": budget,
            }
        )
    return dispatched


def release_worker(worker: str, task_id: str, note: str) -> None:
    run([str(ROOT / "bin/logres-control"), "release", task_id])
    run(
        [
            BRAIN,
            "release",
            worker,
            task_id,
            "--status",
            "READY",
            "--note",
            note[:1800],
        ]
    )


def materialize_worker(
    worker: str,
    task_id: str,
    branch: str,
) -> tuple[Path | None, str]:
    try:
        started = run(
            [WORKER_START, worker, task_id, branch],
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        return None, "worker-start timed out"
    detail = ((started.stderr or "") + "\n" + (started.stdout or "")).strip()
    if started.returncode:
        return None, detail[-2000:]
    for line in (started.stdout or "").splitlines():
        if line.startswith("worktree="):
            path = Path(line.split("=", 1)[1].strip())
            if path.is_dir():
                return path, detail
    return None, "worker-start did not report a valid worktree"


def dispatch_devin(
    conn: sqlite3.Connection,
    cfg: dict,
    *,
    limit: int,
) -> dict:
    result: dict = {"dispatched": 0, "jobs": []}
    if limit <= 0:
        return result
    if not Path(DEVIN_AGENT).is_file() or not Path(DEVIN_ISOLATE).is_file() or not Path(NEXUS).is_file():
        result["blocked"] = "devin_runtime_missing"
        return result
    if not DEVIN_WORKER_CONFIG.is_file():
        result["blocked"] = "devin_worker_config_missing"
        return result

    worker_cfg = load_json(DEVIN_WORKER_CONFIG)
    router = worker_cfg.get("router", {}) if isinstance(worker_cfg, dict) else {}
    if not bool(router.get("enabled", False)):
        result["blocked"] = "router_disabled"
        return result
    if bool(router.get("allow_paid", False)):
        result["blocked"] = "automatic_paid_devin_forbidden"
        return result
    permission_mode = str(router.get("permission_mode") or "smart")
    if permission_mode != "smart":
        result["blocked"] = "unsupported_permission_mode"
        return result

    certificate = load_json(DEVIN_CERTIFICATE)
    head = run(["git", "-C", INTEGRATION_CHECKOUT, "rev-parse", "HEAD"], timeout=30)
    integration_sha = (head.stdout or "").strip() if head.returncode == 0 else ""
    runtime_deployment = load_json(DEVIN_RUNTIME_DEPLOYMENT)
    certificate_ok, certificate_blocker = isolation_certificate_gate(
        certificate, integration_sha, runtime_deployment
    )
    if not certificate_ok:
        result["blocked"] = certificate_blocker or "isolation_not_certified"
        return result

    cap = swarm_capacity(conn, cfg)
    max_active = int(router.get("max_active", 2) or 2)
    remaining = max(0, max_active - cap.active_devin)
    workers = available_devin_worker_ids(conn, worker_cfg)
    limit = min(limit, remaining, len(workers))
    if limit <= 0:
        return result

    devin_bin = str(router.get("devin_bin") or "devin")
    requested_model = str(router.get("model") or "swe-2-max")
    try:
        report = devin_models_report(run, devin_bin)
        model = select_model(report, requested_model, allow_paid=False)
    except (DevinAgentError, OSError, subprocess.TimeoutExpired) as exc:
        result["blocked"] = "free_model_unavailable"
        result["error"] = f"{type(exc).__name__}: {exc}"[:1200]
        return result

    candidates = select_implementation_tasks(conn, max(1, limit) * 4)
    for task in candidates:
        if len(result["jobs"]) >= limit:
            break
        task_id = str(task["id"])
        worker = workers[len(result["jobs"])]
        register_worker(ROOT, worker)
        branch = acquire_task(ROOT, worker, task_id)
        if not branch:
            continue

        worktree, detail = materialize_worker(worker, task_id, branch)
        if worktree is None:
            release_worker(
                worker,
                task_id,
                "Devin worker bootstrap failed; task returned READY. " + detail,
            )
            continue

        spec_argv = [
            "--task", task_id,
            "--worker", worker,
            "--branch", branch,
            "--worktree", str(worktree),
        ]
        prepared = run([DEVIN_ISOLATE, "prepare", *spec_argv], timeout=60)
        if prepared.returncode:
            detail = ((prepared.stderr or "") + "\n" + (prepared.stdout or "")).strip()
            release_worker(
                worker, task_id,
                "Devin isolation prepare failed; task returned READY. " + detail[-1400:]
            )
            continue

        identity = {"chatId": worker, "taskId": task_id, "branch": branch}
        provision = nexus_tool(
            "nexus_logres_devin_network_provision", identity, timeout=60
        )
        if provision.returncode:
            cleanup_devin_isolation(worker, task_id, branch)
            detail = ((provision.stderr or "") + "\n" + (provision.stdout or "")).strip()
            release_worker(
                worker, task_id,
                "Devin network provision failed closed; task returned READY. " + detail[-1400:]
            )
            continue

        preflight = run(
            [DEVIN_ISOLATE, "preflight", *spec_argv, "--json"],
            timeout=int(router.get("preflight_timeout_seconds", 120) or 120),
        )
        try:
            preflight_report = json.loads(preflight.stdout or "{}")
        except json.JSONDecodeError:
            preflight_report = {}
        if preflight.returncode or not bool(preflight_report.get("production_ready", False)):
            cleanup_devin_isolation(worker, task_id, branch)
            detail = ((preflight.stderr or "") + "\n" + (preflight.stdout or "")).strip()
            release_worker(
                worker, task_id,
                "Devin OS isolation preflight failed closed; task returned READY. " + detail[-1400:]
            )
            continue
        unit = str(preflight_report.get("unit") or "").strip()
        if not unit:
            cleanup_devin_isolation(worker, task_id, branch)
            release_worker(
                worker, task_id,
                "Devin OS isolation preflight omitted the systemd unit; task returned READY."
            )
            continue

        try:
            job_id = create_job(
                conn,
                task_id,
                worker,
                "devin",
                branch=branch,
                model=model,
                verification="devin-agent-artifact",
            )
        except sqlite3.IntegrityError:
            cleanup_devin_isolation(worker, task_id, branch)
            release_worker(
                worker,
                task_id,
                "Duplicate live Devin swarm job detected; released safely.",
            )
            continue

        launch_payload = {
            "chatId": worker,
            "taskId": task_id,
            "branch": branch,
            "jobId": job_id,
            "model": model,
            "permissionMode": permission_mode,
        }
        launch = nexus_tool(
            "nexus_logres_devin_transient_start",
            launch_payload,
            timeout=int(router.get("launch_timeout_seconds", 120) or 120),
        )
        if launch.returncode:
            cleanup_devin_isolation(worker, task_id, branch)
            detail = ((launch.stderr or "") + "\n" + (launch.stdout or "")).strip()
            conn.execute(
                """update swarm_jobs
                      set state='FAILED',last_error=?,updated_at=datetime('now'),
                          finished_at=datetime('now')
                    where id=?""",
                (("Devin governed transient launch failed: " + detail)[-1800:], job_id),
            )
            conn.commit()
            release_worker(
                worker, task_id,
                "Devin governed transient launch failed; task returned READY. " + detail[-1400:]
            )
            continue

        try:
            privileged = json.loads(launch.stdout or "{}")
        except json.JSONDecodeError:
            privileged = {}
        properties = str(privileged.get("stdout") or "")
        match = re.search(r"(?m)^MainPID=(\d+)$", properties)
        main_pid = int(match.group(1)) if match else 0
        if main_pid <= 0:
            cleanup_devin_isolation(worker, task_id, branch)
            conn.execute(
                """update swarm_jobs
                      set state='FAILED',last_error=?,updated_at=datetime('now'),
                          finished_at=datetime('now')
                    where id=?""",
                ("Devin governed transient unit did not expose a live MainPID", job_id),
            )
            conn.commit()
            release_worker(
                worker, task_id,
                "Devin governed transient unit had no live MainPID; cleaned up and returned READY."
            )
            continue

        isolation_name = re.sub(r"[^A-Za-z0-9._-]+", "-", worktree.name).strip("-.")[:48] or "worker"
        log_path = str(ROOT / "logs/devin-workers" / isolation_name / "devin.log")
        mark_job_running(conn, job_id, main_pid, session_id=f"systemd:{unit}")
        result["jobs"].append(
            {
                "task_id": task_id,
                "worker_id": worker,
                "job_id": job_id,
                "pid": main_pid,
                "session_id": f"systemd:{unit}",
                "unit": unit,
                "branch": branch,
                "worktree": str(worktree),
                "model": model,
                "log": log_path,
                "isolation_certificate": str(DEVIN_CERTIFICATE),
            }
        )

    result["dispatched"] = len(result["jobs"])
    return result

def dispatch_patch(
    conn: sqlite3.Connection,
    cfg: dict,
    *,
    limit: int,
) -> list[dict]:
    impl = cfg.get("implementation", {})
    if not bool(impl.get("enabled", False)) or limit <= 0:
        return []
    if not Path(PATCH_AGENT).is_file() or not Path(WORKER_START).is_file():
        return []

    workers = available_patch_worker_ids(conn, cfg)
    if not workers:
        return []

    cap = swarm_capacity(conn, cfg)
    max_active = int(impl.get("max_active", 1) or 1)
    remaining_active = max(0, max_active - cap.active_patch)
    limit = min(limit, len(workers), remaining_active)
    if limit <= 0:
        return []

    model = str(
        impl.get("model")
        or cfg.get("openai", {}).get("auto_model")
        or "gpt-5.6-luna"
    )
    max_attempts = int(impl.get("max_attempts", 2) or 2)
    timeout_seconds = int(impl.get("timeout_seconds", 1800) or 1800)
    candidates = select_implementation_tasks(conn, max(1, limit) * 4)
    dispatched: list[dict] = []

    for task in candidates:
        if len(dispatched) >= limit:
            break
        task_id = str(task["id"])
        failures = prior_failures(conn, task_id, engine="openai-patch")
        if failures >= max_attempts:
            post_once(
                f"OpenAI patch retry ceiling: {task_id}",
                (
                    f"Automatic implementation failed {failures} time(s); "
                    "leaving task READY for manual/Lead review."
                ),
                f"patch-retry-ceiling:{task_id}:{failures}",
                task_id,
            )
            continue

        priority = int(task.get("priority") or 9)
        budget = budget_state(conn, cfg, priority, model)
        if not automatic_api_allowed(budget, priority):
            continue

        worker = workers[len(dispatched)]
        register_worker(ROOT, worker)
        branch = acquire_task(ROOT, worker, task_id)
        if not branch:
            continue

        worktree, detail = materialize_worker(worker, task_id, branch)
        if worktree is None:
            release_worker(
                worker,
                task_id,
                "OpenAI patch worker bootstrap failed; task returned READY. " + detail,
            )
            continue

        try:
            job_id = create_job(
                conn,
                task_id,
                worker,
                "openai-patch",
            )
        except sqlite3.IntegrityError:
            release_worker(
                worker,
                task_id,
                "Duplicate live swarm implementation job detected; released safely.",
            )
            continue

        LOGS.mkdir(parents=True, exist_ok=True)
        log_path = LOGS / f"{job_id}-{task_id}-patch.log"
        log_handle = open(log_path, "ab", buffering=0)
        try:
            proc = subprocess.Popen(
                [
                    "/usr/bin/timeout",
                    "--signal=TERM",
                    "--kill-after=30s",
                    str(timeout_seconds),
                    PATCH_AGENT,
                    "--task",
                    task_id,
                    "--worker",
                    worker,
                    "--job-id",
                    str(job_id),
                    "--branch",
                    branch,
                    "--worktree",
                    str(worktree),
                ],
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
                env=os.environ.copy(),
            )
        except OSError as exc:
            log_handle.close()
            conn.execute(
                """update swarm_jobs
                      set state='FAILED',last_error=?,updated_at=datetime('now'),
                          finished_at=datetime('now')
                    where id=?""",
                (f"worker launch failed: {exc}", job_id),
            )
            conn.commit()
            release_worker(
                worker,
                task_id,
                f"OpenAI patch worker launch failed; task returned READY. {exc}",
            )
            continue
        log_handle.close()
        mark_job_running(conn, job_id, proc.pid)
        dispatched.append(
            {
                "task_id": task_id,
                "worker_id": worker,
                "job_id": job_id,
                "pid": proc.pid,
                "branch": branch,
                "worktree": str(worktree),
                "log": str(log_path),
                "budget": budget,
                "model": model,
                "timeout_seconds": timeout_seconds,
            }
        )
    return dispatched


def placement_hints(
    conn: sqlite3.Connection,
    task_ids: list[str],
) -> list[dict]:
    hints = []
    for task_id in task_ids[:8]:
        try:
            workload, sensitivity = infer_task_workload(conn, task_id)
            plan = plan_workload(
                workload=workload,
                sensitivity=sensitivity,
            )
        except Exception as exc:
            hints.append(
                {
                    "task_id": task_id,
                    "selected_lane": None,
                    "error": f"{type(exc).__name__}: {exc}",
                }
            )
            continue
        hints.append(
            {
                "task_id": task_id,
                "workload": workload,
                "sensitivity": sensitivity,
                "selected_lane": plan.selected_lane,
                "policy": plan.policy,
            }
        )
    return hints


def dispatch_copilot(limit: int) -> dict:
    if limit <= 0:
        return {"dispatched": 0, "jobs": []}
    result = run([COPILOT, "--limit", str(limit)])
    if result.returncode:
        return {
            "dispatched": 0,
            "jobs": [],
            "error": ((result.stderr or "") + (result.stdout or ""))[-2000:],
        }
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return {
            "dispatched": 0,
            "jobs": [],
            "error": result.stdout[-2000:],
        }


def tick(dry_run: bool = False) -> dict:
    supervisor = {"ensured": False}
    if not dry_run and Path(SUPERVISOR).is_file():
        try:
            ensured = subprocess.run(
                [SUPERVISOR, "ensure"],
                text=True,
                capture_output=True,
                check=False,
                timeout=8,
            )
            supervisor = {
                "ensured": ensured.returncode == 0,
                "returncode": ensured.returncode,
            }
        except (OSError, subprocess.TimeoutExpired) as exc:
            supervisor = {
                "ensured": False,
                "error": f"{type(exc).__name__}: {exc}",
            }

    cfg = load_config(CONFIG)
    swarm_cfg = cfg.get("swarm", {})
    conn = connect()
    stale = reconcile_jobs(conn)
    recovered = release_stale(conn, stale)

    knowledge_refresh = refresh_graph(conn)
    observations = record_swarm_observations(conn)
    knowledge = graph_stats(conn)

    before = swarm_capacity(conn, cfg)
    payload = {
        "supervisor": supervisor,
        "knowledge_refresh": knowledge_refresh,
        "knowledge_graph": knowledge,
        "optimizer_observations_added": observations,
        "enabled": bool(swarm_cfg.get("enabled", False)),
        "before": before.__dict__,
        "stale_recovered": recovered,
        "devin": {"dispatched": 0, "jobs": []},
        "copilot": {"dispatched": 0, "jobs": []},
        "implementation": [],
        "research": [],
        "dry_run": dry_run,
    }
    if not payload["enabled"] or before.free_slots <= 0:
        payload["after"] = swarm_capacity(conn, cfg).__dict__
        conn.close()
        return payload

    if dry_run:
        payload["implementation_candidates"] = [
            task["id"]
            for task in select_implementation_tasks(
                conn,
                before.free_slots,
            )
        ]
        payload["research_candidates"] = [
            task["id"]
            for task in select_research_tasks(
                conn,
                before.free_slots,
            )
        ]
        payload["placement_hints"] = placement_hints(
            conn,
            [task["id"] for task in ready_tasks(conn)],
        )
        payload["after"] = before.__dict__
        conn.close()
        return payload

    # Cloud Devin is the preferred autonomous implementation lane, but it
    # remains fail-closed until an independent production isolation proof has
    # written the certificate consumed by dispatch_devin. Paid Devin models
    # are never selected by this automatic path.
    worker_cfg = load_json(DEVIN_WORKER_CONFIG)
    router_cfg = worker_cfg.get("router", {}) if isinstance(worker_cfg, dict) else {}
    devin_limit = min(
        before.free_slots,
        int(router_cfg.get("dispatch_per_tick", 2) or 2),
    )
    payload["devin"] = dispatch_devin(conn, cfg, limit=devin_limit)

    # Existing engines remain first-class fallbacks after the Devin lane has
    # consumed only its bounded capacity.
    cap = swarm_capacity(conn, cfg)
    impl_limit = min(
        cap.free_slots,
        int(swarm_cfg.get("implementation_dispatch_per_tick", 2) or 2),
    )
    payload["copilot"] = dispatch_copilot(impl_limit)

    cap = swarm_capacity(conn, cfg)
    openai_hard = int(
        cfg.get("openai", {}).get("max_active_hard", 2) or 2
    )
    patch_limit = min(
        cap.free_slots,
        impl_limit,
        max(0, openai_hard - cap.active_research - cap.active_patch),
    )
    payload["implementation"] = dispatch_patch(
        conn,
        cfg,
        limit=patch_limit,
    )

    # Recompute because implementation workers hold Brain leases.
    cap = swarm_capacity(conn, cfg)
    research_cfg_limit = int(
        swarm_cfg.get("research_workers", 2) or 2
    )
    openai_soft_limit = int(
        cfg.get("openai", {}).get("max_active_hard", research_cfg_limit)
        or research_cfg_limit
    )
    research_limit = min(
        cap.free_slots,
        max(0, research_cfg_limit - cap.active_research),
        max(0, openai_soft_limit - cap.active_patch),
    )
    payload["research"] = dispatch_research(
        conn,
        cfg,
        limit=research_limit,
    )
    payload["after"] = swarm_capacity(conn, cfg).__dict__
    conn.close()
    return payload


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-swarm")
    sub = ap.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    tick_p = sub.add_parser("tick")
    tick_p.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    cfg = load_config(CONFIG)
    conn = connect()
    if args.command == "status":
        reconcile_jobs(conn)
        refresh_graph(conn)
        record_swarm_observations(conn)
        out = status_dict(conn, cfg)
        out["knowledge_graph"] = graph_stats(conn)
        out["placement_hints"] = placement_hints(
            conn,
            [item["task_id"] for item in out.get("ready", [])],
        )
        conn.close()
        print(json.dumps(out, indent=2, sort_keys=True))
        return 0
    conn.close()
    print(json.dumps(tick(args.dry_run), indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
