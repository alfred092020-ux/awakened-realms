#!/usr/bin/env python3
import argparse,json,os,sqlite3,subprocess,sys
from datetime import datetime
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres"))
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_replay import capture,list_snapshots,replay_at
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
def connect():
    c=sqlite3.connect(DB,timeout=30); c.row_factory=sqlite3.Row; c.execute("pragma busy_timeout=30000"); return c
def sha():
    return subprocess.check_output(["git","-C",str(ROOT/"src/awakened-realms"),"rev-parse","feat/logres-reconstruction"],text=True).strip()
def epoch(value):
    try: return float(value)
    except ValueError: return datetime.fromisoformat(value.replace("Z","+00:00")).timestamp()
def main():
    p=argparse.ArgumentParser(prog="logres-replay"); s=p.add_subparsers(dest="cmd",required=True)
    c=s.add_parser("capture"); c.add_argument("--sha")
    r=s.add_parser("at"); r.add_argument("timestamp")
    l=s.add_parser("list"); l.add_argument("--limit",type=int,default=20)
    a=p.parse_args(); db=connect()
    try:
        if a.cmd=="capture": out=capture(db,a.sha or sha())
        elif a.cmd=="at": out=replay_at(db,epoch(a.timestamp))
        else: out=list_snapshots(db,a.limit)
    finally: db.close()
    print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__": main()
