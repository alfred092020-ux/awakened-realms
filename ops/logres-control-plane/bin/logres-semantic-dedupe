#!/usr/bin/env python3
import argparse,json,os,sqlite3,sys
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres"));sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_semantic_dedupe import canonical,duplicates
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
def main():
 p=argparse.ArgumentParser(prog="logres-semantic-dedupe");s=p.add_subparsers(dest="cmd",required=True)
 f=s.add_parser("fingerprint");f.add_argument("task_id"); d=s.add_parser("duplicates");d.add_argument("--status",action="append")
 a=p.parse_args();c=sqlite3.connect(DB,timeout=30);c.row_factory=sqlite3.Row;c.execute("pragma busy_timeout=30000")
 try: out=canonical(c,a.task_id) if a.cmd=="fingerprint" else duplicates(c,a.status)
 finally:c.close()
 print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__":main()
