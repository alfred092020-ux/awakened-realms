#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_impact import (
    ensure_schema,
    impact_plan,
    incident_status,
    scan_conflicts,
)
from logres_knowledge import refresh_graph

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(
    os.environ.get(
        "LOGRES_CONTROL_DB",
        str(ROOT / "control/control.sqlite"),
    )
)


def connect() -> sqlite3.Connection:
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    ensure_schema(conn)
    return conn


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-impact")
    sub = ap.add_subparsers(dest="command", required=True)

    task = sub.add_parser("task")
    task.add_argument("task_id")

    scan = sub.add_parser("scan")
    scan.add_argument("--apply", action="store_true")
    scan.add_argument("--limit", type=int, default=100)

    status = sub.add_parser("status")
    status.add_argument("--limit", type=int, default=100)

    args = ap.parse_args()
    conn = connect()
    try:
        if args.command == "task":
            refresh_graph(conn)
            payload = impact_plan(conn, args.task_id).to_dict()
        elif args.command == "scan":
            refresh_graph(conn)
            payload = scan_conflicts(
                conn,
                apply=args.apply,
                limit=args.limit,
            )
        else:
            payload = {
                "incidents": incident_status(conn, args.limit),
            }
    finally:
        conn.close()

    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
