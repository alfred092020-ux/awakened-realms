#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path


CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_preview_reaper import current_candidate_safe, reap, scan


ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(
    os.environ.get(
        "LOGRES_CONTROL_DB",
        str(ROOT / "control" / "control.sqlite"),
    )
)
REPO = Path(
    os.environ.get(
        "LOGRES_REPO_ROOT",
        str(ROOT / "src" / "awakened-realms"),
    )
)


def connect() -> sqlite3.Connection:
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    return conn


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="logres-preview-reaper",
        description=(
            "Safely report or reap abandoned Vite preview servers from "
            "clean, merged, inactive Logres worktrees."
        ),
    )
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--age-hours", type=float, default=2.0)
    parser.add_argument("--term-wait-seconds", type=float, default=1.0)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if args.age_hours < 0:
        parser.error("--age-hours must be >= 0")
    if args.term_wait_seconds < 0 or args.term_wait_seconds > 10:
        parser.error("--term-wait-seconds must be between 0 and 10")

    conn = connect()
    try:
        rows = scan(
            conn,
            min_age_seconds=args.age_hours * 3600,
        )
    finally:
        conn.close()

    records = []
    eligible = []
    for process, worktree, decision in rows:
        record = {
            "pid": process.pid,
            "age_seconds": round(process.age_seconds, 3),
            "rss_bytes": process.rss_bytes,
            "worktree_path": process.worktree_path,
            "branch": worktree.branch if worktree else None,
            "eligible": decision.eligible,
            "reason": decision.reason,
        }
        records.append(record)
        if decision.eligible:
            eligible.append(process)

    result = None
    if args.apply:
        min_age_seconds = args.age_hours * 3600
        result = reap(
            eligible,
            term_wait_seconds=args.term_wait_seconds,
            eligible_fn=lambda process: current_candidate_safe(
                process,
                DB,
                REPO,
                min_age_seconds=min_age_seconds,
            ),
        )

    payload = {
        "apply": args.apply,
        "age_hours": args.age_hours,
        "processes": records,
        "eligible_count": len(eligible),
        "eligible_rss_bytes": sum(p.rss_bytes for p in eligible),
        "reap": result,
    }

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for record in records:
            status = "ELIGIBLE" if record["eligible"] else "KEEP"
            age_h = record["age_seconds"] / 3600
            rss_mb = record["rss_bytes"] / 1048576
            print(
                f"{status:8} pid={record['pid']} age_h={age_h:.1f} "
                f"rss_mb={rss_mb:.1f} reason={record['reason']} "
                f"branch={record['branch'] or '-'} "
                f"path={record['worktree_path']}"
            )
        print(
            f"SUMMARY apply={str(args.apply).lower()} "
            f"eligible={len(eligible)} "
            f"rss_mb={payload['eligible_rss_bytes']/1048576:.1f}"
        )
        if result:
            print(
                "REAP "
                f"term_sent={result['term_sent']} "
                f"survived_term={result['survived_term']} "
                f"kill_sent={result['kill_sent']}"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
