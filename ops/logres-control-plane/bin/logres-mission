#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_mission import (
    load_config,
    mission_status,
    objective_status,
    tree_lines,
)

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(os.environ.get("LOGRES_CONTROL_DB", ROOT / "control/control.sqlite"))
DEFAULT_CONFIG = CONTROL_ROOT / "config/mission.default.json"
def connect() -> sqlite3.Connection:
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    return conn


def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-mission")
    sub = parser.add_subparsers(dest="command", required=True)

    init = sub.add_parser("init")
    init.add_argument("--config", type=Path, default=DEFAULT_CONFIG)

    sub.add_parser("status")

    tree = sub.add_parser("tree")
    tree.add_argument("objective_id", nargs="?")
    tree.add_argument("--json", action="store_true")

    objective = sub.add_parser("objective")
    objective.add_argument("objective_id")

    sub.add_parser("gaps")
    args = parser.parse_args()
    conn = connect()
    try:
        if args.command == "init":
            payload = load_config(conn, args.config)
        elif args.command == "status":
            payload = mission_status(conn)
        elif args.command == "objective":
            payload = objective_status(conn, args.objective_id).to_dict()
        elif args.command == "gaps":
            status = mission_status(conn)
            payload = {
                "count": len(status["uncovered"]),
                "objectives": status["uncovered"],
            }
        else:
            status = mission_status(conn)
            if args.objective_id:
                node = objective_status(conn, args.objective_id).to_dict()
                nodes = [node]
            else:
                nodes = status["missions"]
            if args.json:
                payload = nodes
            else:
                for node in nodes:
                    for line in tree_lines(node):
                        print(line)
                return 0
    finally:
        conn.close()

    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
