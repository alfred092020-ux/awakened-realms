# Emergency memory headroom for parallel heavy analysis/build jobs.
swap=run(["swapon","--show=NAME,SIZE,USED","--noheadings"]).stdout.strip()
swappiness=proc_int("/proc/sys/vm/swappiness")
add("emergency_swap","PASS" if "/swapfile" in swap and 0 <= swappiness <= 20 else "WARN",
    (swap.replace("\n","; ") if swap else "no swap")+f" swappiness={swappiness}")

# Legacy dependency duplication should stay low; managed worktrees share canonical deps.
local_dep_bytes=0
local_dep_count=0
for root in (Path("/home/ubuntu/logres/tmp"),Path("/home/ubuntu/logres/work")):
    if not root.exists():
        continue
    for d in root.iterdir():
        nm=d/"node_modules"
        if nm.is_dir() and not nm.is_symlink():
            out=run(["du","-sb",str(nm)]).stdout.split()
            if out:
                local_dep_bytes += int(out[0]); local_dep_count += 1
add("shared_dependencies","PASS" if local_dep_bytes <= 1024**3 else "WARN",
    f"local_copies={local_dep_count} local_bytes={local_dep_bytes}")

branch_sweep=Path("/home/ubuntu/logres/control/BRANCH_SWEEP.json")
if branch_sweep.exists():
    age=now-branch_sweep.stat().st_mtime
    add("branch_sweep","PASS" if age<600 else "WARN",f"age={age:.0f}s")
else:
    add("branch_sweep","WARN","missing")

for check_name,check_path in [
    ("branch_archaeology",Path("/home/ubuntu/logres/control/BRANCH_ARCHAEOLOGY.json")),
    ("integration_review",Path("/home/ubuntu/logres/control/integration-review/INDEX.json")),
]:
    if check_path.exists():
        age=now-check_path.stat().st_mtime
        add(check_name,"PASS" if age<600 else "WARN",f"age={age:.0f}s")
    else:
        add(check_name,"WARN","missing")

# Capacity
st=os.statvfs("/")
free=st.f_bavail*st.f_frsize
add("disk_free","PASS" if free>20*1024**3 else "WARN",f"{free/1024**3:.1f} GiB")
meminfo=Path("/proc/meminfo").read_text()
avail_kb=int(next(x.split()[1] for x in meminfo.splitlines() if x.startswith("MemAvailable:")))
add("memory_available","PASS" if avail_kb>4*1024*1024 else "WARN",f"{avail_kb/1024/1024:.1f} GiB")
# Temporary verification worktrees: only abandoned/inactive paths are leaks.
verify_candidates=(list(Path("/home/ubuntu/logres/tmp").glob("verify-once.*"))
       +list(Path("/home/ubuntu/logres/tmp").glob("verify-all-once.*"))
       +list(Path("/dev/shm/logres").glob("verify-farm-*")))
def verify_path_in_use(p:Path)->bool:
    needle=str(p)
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            cwd=os.readlink(proc/"cwd")
        except Exception:
            cwd=""
        try:
            cmd=(proc/"cmdline").read_bytes().replace(b"\0",b" ").decode(errors="replace")
        except Exception:
            cmd=""
        if cwd==needle or cwd.startswith(needle+"/") or needle in cmd:
            return True
    return False
leaks=[p for p in verify_candidates if not verify_path_in_use(p)]
active_verify=len(verify_candidates)-len(leaks)
add("verify_temp_leaks","PASS" if not leaks else "WARN",
    f"abandoned={len(leaks)} active={active_verify}")
gh=Path("/home/ubuntu/logres/ghidra_projects/logres-current-jp-light.rep")
add("ghidra_light_project","PASS" if gh.exists() else "FAIL",f"{gh.stat().st_size if gh.exists() else 0} bytes")

# Quarantine/malware-analysis lab.
qstatus=Path("/home/ubuntu/quarantine/STATUS.txt")
qtools=all(shutil.which(x) for x in ("yara","clamscan","podman"))
qimage=run(["podman","image","exists","localhost/quarantine-analysis:24.04"]).returncode==0
qok=qstatus.exists() and qtools and qimage
add("quarantine_lab","PASS" if qok else "WARN",
    "network-none/read-only analysis image ready" if qok else "incomplete")

# Control-plane refresh without network
ctl=run(["/home/ubuntu/logres/bin/logres-control","dashboard"])
add("control_plane","PASS" if ctl.returncode==0 else "FAIL","ok" if ctl.returncode==0 else ctl.stdout[-500:])

for name,status,detail in checks:
    print(f"{status:4} {name:24} {detail}")
print(f"SUMMARY fails={fails} warnings={warns} checks={len(checks)}")
raise SystemExit(1 if fails else 0)
