#!/usr/bin/env python3
import argparse,json,os,sqlite3,subprocess,sys
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres"));REPO=ROOT/"src/awakened-realms"
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_architecture_pressure import evaluate,persist
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
def count(c,sql):
 r=c.execute(sql).fetchone();return int(r[0] or 0)
def git_count(args):
 return len(subprocess.check_output(["git","-C",str(REPO),*args],text=True).splitlines())
def main():
 p=argparse.ArgumentParser(prog="logres-architecture-pressure");p.add_argument("--apply",action="store_true");a=p.parse_args()
 c=sqlite3.connect(DB,timeout=30);c.row_factory=sqlite3.Row;c.execute("pragma busy_timeout=30000")
 worktrees=subprocess.check_output(["git","-C",str(REPO),"worktree","list","--porcelain"],text=True).count("worktree ")
 incomplete=count(c,"select count(*) from tasks where status not in ('DONE','SUPERSEDED','CANCELLED')")
 metrics={
  "worktrees":worktrees,
  "local_branches":git_count(["for-each-ref","--count=100000","refs/heads","--format=%(refname)"]),
  "remote_branches":git_count(["for-each-ref","--count=100000","refs/remotes/origin","--format=%(refname)"]),
  "incomplete_tasks":incomplete,
  "blocked_evidence":count(c,"select count(*) from tasks where status='BLOCKED_EVIDENCE'"),
  "blocked_dep":count(c,"select count(*) from tasks where status='BLOCKED_DEP'"),
  "integration_backlog":count(c,"select count(*) from integration_queue where status not in ('INTEGRATED','SUPERSEDED')"),
  "stale_engine_records":count(c,"""select count(*) from copilot_jobs x join tasks t on t.id=x.task_id where x.state in ('ACTIVE','VERIFYING','QUEUED') and t.status in ('DONE','SUPERSEDED','CANCELLED','BLOCKED_EVIDENCE')"""),
  "control_tables":count(c,"select count(*) from sqlite_master where type='table'"),
  "worker_utilization":count(c,"select count(*) from brain_task_leases")/6.0,
  "decision_records":count(c,"select count(*) from project_decisions") if c.execute("select 1 from sqlite_master where type='table' and name='project_decisions'").fetchone() else 0,
  "significant_events":count(c,"select count(*) from brain_events where event_type in ('DONE','BLOCKER','HANDOFF','EVIDENCE_CONFLICT','REGRESSION')"),
 }
 out=evaluate(metrics)
 if a.apply:out["observation_id"]=persist(c,out)
 c.close();print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__":main()
