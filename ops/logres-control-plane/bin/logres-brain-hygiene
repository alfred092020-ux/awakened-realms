#!/usr/bin/env python3
from __future__ import annotations
import argparse,re,sqlite3,time
from datetime import datetime,timezone
from pathlib import Path
import os
ROOT=Path(os.environ.get('LOGRES_ROOT','/home/ubuntu/logres'))
DB=Path(os.environ.get('LOGRES_CONTROL_DB',str(ROOT/'control/control.sqlite')))
BASE_RE=re.compile(r' against [0-9a-f]{7,40}',re.I)
PARENT_RE=re.compile(r'blocking (REG-[A-Z0-9-]+)',re.I)
ACTIONABLE=('ACTIVE','READY','BLOCKED_DEP','BLOCKED_EVIDENCE')
def stamp(): return datetime.now(timezone.utc).isoformat(timespec='seconds')
def main():
 ap=argparse.ArgumentParser(); ap.add_argument('--apply',action='store_true'); args=ap.parse_args()
 c=sqlite3.connect(DB,timeout=30); c.row_factory=sqlite3.Row; c.execute('pragma busy_timeout=30000')
 leased={r[0] for r in c.execute("select task_id from brain_task_leases where lease_until_epoch>?",(time.time(),))} if c.execute("select 1 from sqlite_master where type='table' and name='brain_task_leases'").fetchone() else set()
 rows=list(c.execute("select id,title,updated_at from tasks where status='READY' and id like 'REG-INTEGRATION-CONFLICT-%' order by updated_at desc,id desc"))
 groups={}
 for r in rows: groups.setdefault(BASE_RE.sub(' against <BASE_SHA>',r['title']),[]).append(r)
 supersede=[]
 for members in groups.values():
  keep=next((r for r in members if r['id'] in leased),members[0])
  supersede += [r['id'] for r in members if r['id']!=keep['id'] and r['id'] not in leased]
 superseded=set(supersede)
 children=[]
 for r in c.execute("select id,title from tasks where status in ('READY','BLOCKED_DEP','BLOCKED_EVIDENCE') and id like 'REPAIR-%'"):
  m=PARENT_RE.search(r['title'] or '')
  if m and m.group(1).upper() in superseded and r['id'] not in leased: children.append(r['id'])
 if args.apply:
  now=stamp()
  for tid in supersede+children:
   c.execute("update tasks set status='SUPERSEDED',note=coalesce(note,'')||?,updated_at=? where id=?",("; hygiene: superseded redundant generated lineage",now,tid))
  c.commit()
 counts={r['status']:r['n'] for r in c.execute('select status,count(*) n from tasks group by status')}
 print({'apply':args.apply,'integration_conflicts_superseded':len(supersede),'repair_children_superseded':len(children),'leased_preserved':len(leased),'status_counts':counts})
 c.close()
if __name__=='__main__': main()
