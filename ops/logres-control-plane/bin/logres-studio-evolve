#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
import logres_studio_evolution as evolution


def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-studio-evolve")
    parser.add_argument("--db", default="/home/ubuntu/logres/control/control.sqlite")
    sub = parser.add_subparsers(dest="command", required=True)
    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    args = parser.parse_args()
    conn = sqlite3.connect(args.db, timeout=30)
    conn.row_factory = sqlite3.Row
    try:
        evolution.ensure_schema(conn)
        payload = evolution.restart_state(conn)
        payload["direct_integration_authority"] = False
        if args.command == "status":
            if args.json:
                print(json.dumps(payload, sort_keys=True))
            else:
                print(f"active_version={payload['active_version']}")
                print("direct_integration_authority=false")
            return 0
    finally:
        conn.close()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
