#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_chaos_cert import certify, run_probes

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
REPO = Path(
    os.environ.get(
        "LOGRES_REPO_ROOT",
        str(ROOT / "src/awakened-realms"),
    )
)
ARTIFACT_ROOT = Path(
    os.environ.get(
        "LOGRES_CHAOS_CERT_ARTIFACT_ROOT",
        str(ROOT / "artifacts/chaos-cert"),
    )
)


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="logres-chaos-cert",
        description=(
            "Executable sandbox resilience certification. "
            "Never opens the production control DB."
        ),
    )
    sub = ap.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run")
    run.add_argument("--shadow", action="store_true")
    run.add_argument("--quiet", action="store_true")

    sub.add_parser("probe")

    args = ap.parse_args()
    if args.command == "probe":
        payload = {
            "sandbox_only": True,
            "production_control_db_opened": False,
            "probes": [probe.to_dict() for probe in run_probes()],
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0 if all(item["passed"] for item in payload["probes"]) else 1

    try:
        payload = certify(
            repo=REPO,
            artifact_root=ARTIFACT_ROOT,
            shadow=args.shadow,
        )
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    if not args.quiet:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(
            f"CHAOS_CERT {payload['verdict']} "
            f"sha={payload['canonical_sha'][:12]} "
            f"probes={payload['passed_count']}/{payload['probe_count']} "
            f"artifact={payload['artifact_path']}"
        )
    return 0 if payload["verdict"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
