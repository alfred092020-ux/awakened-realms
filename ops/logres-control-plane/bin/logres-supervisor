#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_supervisor import (
    ensure_running,
    evaluate_failover,
    failover_tick,
    load_state,
    baton_path,
    reload_if_idle,
    run_forever,
    supervisor_health,
    tick,
    write_baton,
)

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
HEARTBEAT = Path(os.environ.get("LOGRES_SUPERVISOR_HEARTBEAT", str(ROOT / "control/supervisor-heartbeat.json")))
LOCK = Path(os.environ.get("LOGRES_SUPERVISOR_LOCK", "/tmp/logres-supervisor.lock"))
RELOAD_LOCK = Path(
    os.environ.get(
        "LOGRES_SUPERVISOR_RELOAD_LOCK",
        "/tmp/logres-supervisor-reload.lock",
    )
)


def wait_for_replacement(old_pid: int, *, timeout_seconds: float = 5.0) -> dict:
    deadline = time.monotonic() + timeout_seconds
    latest = supervisor_health(HEARTBEAT)
    while time.monotonic() < deadline:
        latest = supervisor_health(HEARTBEAT)
        new_pid = int(latest.get("pid") or 0)
        if latest.get("healthy") and new_pid and new_pid != old_pid:
            return latest
        time.sleep(0.1)
    return {
        **latest,
        "healthy": False,
        "reason": "replacement supervisor did not publish a healthy heartbeat",
    }


def run_reload_once(*, expected_pid: int | None = None) -> dict:
    result = reload_if_idle(
        ROOT,
        Path(__file__).resolve(),
        HEARTBEAT,
        expected_pid=expected_pid,
    )
    if result.get("reload") in {"reloaded", "started"}:
        old_pid = int(result.get("old_pid") or expected_pid or 0)
        replacement = wait_for_replacement(old_pid)
        result = {
            **result,
            **replacement,
            "new_pid": replacement.get("pid"),
        }
    return result


def schedule_reload_wait(old_pid: int) -> int:
    log = ROOT / "logs" / "supervisor-reload.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("ab", buffering=0) as handle:
        proc = subprocess.Popen(
            [
                str(Path(__file__).resolve()),
                "reload-wait",
                "--expected-pid",
                str(old_pid),
            ],
            stdout=handle,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
        )
    return int(proc.pid)


def reload_wait(expected_pid: int, *, timeout_seconds: float = 600.0) -> dict:
    RELOAD_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with RELOAD_LOCK.open("a+") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return {
                "reload": "watcher-already-running",
                "healthy": True,
                "old_pid": expected_pid,
            }

        deadline = time.monotonic() + timeout_seconds
        while time.monotonic() < deadline:
            result = run_reload_once(expected_pid=expected_pid)
            if result.get("reload") != "deferred":
                return result
            time.sleep(1)
        return {
            "reload": "failed",
            "healthy": False,
            "old_pid": expected_pid,
            "reason": "timed out waiting for supervisor children to exit",
        }


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-supervisor")
    sub = ap.add_subparsers(dest="command", required=True)
    sub.add_parser("run")
    sub.add_parser("tick")
    sub.add_parser("ensure")
    sub.add_parser("reload")
    reload_wait_parser = sub.add_parser("reload-wait")
    reload_wait_parser.add_argument("--expected-pid", type=int, required=True)
    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    baton = sub.add_parser("baton")
    baton.add_argument("--state", required=True)
    baton.add_argument("--objective")
    baton.add_argument("--task")
    baton.add_argument("--note", default="")
    baton.add_argument("--new-generation", action="store_true")
    sub.add_parser("baton-status")
    sub.add_parser("failover")
    args = ap.parse_args()

    if args.command == "run":
        return run_forever(ROOT, HEARTBEAT, LOCK)
    if args.command == "tick":
        print(json.dumps(tick(ROOT, HEARTBEAT), indent=2, sort_keys=True))
        return 0
    if args.command == "ensure":
        result = ensure_running(ROOT, Path(__file__).resolve(), HEARTBEAT)
        if result.get("started"):
            for _ in range(30):
                time.sleep(0.1)
                health = supervisor_health(HEARTBEAT)
                if health.get("healthy"):
                    result = {"started": True, **health}
                    break
            else:
                result = {
                    **result,
                    "healthy": False,
                    "reason": "supervisor did not publish a healthy heartbeat",
                }
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0 if result.get("healthy") else 1

    if args.command == "reload":
        result = run_reload_once()
        if result.get("reload") == "deferred":
            watcher_pid = schedule_reload_wait(int(result["old_pid"]))
            result = {
                **result,
                "reload": "deferred",
                "watcher_pid": watcher_pid,
            }
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0 if result.get("healthy") else 1

    if args.command == "reload-wait":
        result = reload_wait(args.expected_pid)
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0 if result.get("healthy") else 1

    if args.command == "baton":
        record = write_baton(
            ROOT,
            run_state=args.state,
            objective=args.objective,
            task=args.task,
            note=args.note,
            new_generation=args.new_generation,
        )
        print(json.dumps(record, indent=2, sort_keys=True))
        return 0

    if args.command == "baton-status":
        print(
            json.dumps(
                {
                    "baton": load_state(baton_path(ROOT)),
                    "failover": evaluate_failover(ROOT),
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    if args.command == "failover":
        result = failover_tick(ROOT)
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0 if result.get("action") != "error" else 1

    result = supervisor_health(HEARTBEAT)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(
            "SUPERVISOR "
            + ("HEALTHY" if result["healthy"] else "UNHEALTHY")
            + f" pid={result.get('pid') or '-'} age={result.get('age_seconds')}"
        )
    return 0 if result["healthy"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
