#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_knowledge import (
    ensure_schema,
    graph_stats,
    query_nodes,
    refresh_graph,
    task_knowledge,
)

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(os.environ.get("LOGRES_CONTROL_DB", str(ROOT / "control/control.sqlite")))


def connect():
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    ensure_schema(conn)
    return conn


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-knowledge")
    sub = ap.add_subparsers(dest="command", required=True)
    sub.add_parser("refresh")
    sub.add_parser("stats")
    q = sub.add_parser("query")
    q.add_argument("term")
    q.add_argument("--limit", type=int, default=20)
    t = sub.add_parser("task")
    t.add_argument("task_id")
    args = ap.parse_args()

    conn = connect()
    if args.command == "refresh":
        out = {
            "refreshed": refresh_graph(conn),
            "stats": graph_stats(conn),
        }
    elif args.command == "stats":
        out = graph_stats(conn)
    elif args.command == "query":
        out = query_nodes(conn, args.term, args.limit)
    else:
        out = task_knowledge(conn, args.task_id).__dict__
    conn.close()
    print(json.dumps(out, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
