#!/usr/bin/env python3
import argparse,json,os,sqlite3,subprocess,sys
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres"));sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_shadow_scheduler import compare,score_candidates
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
def authoritative():
 try:
  raw=subprocess.check_output([str(ROOT/"bin/logres-optimizer"),"plan","--limit","20"],text=True)
  data=json.loads(raw);return [x["task_id"] for x in data.get("tasks",[])]
 except Exception:return []
def main():
 p=argparse.ArgumentParser(prog="logres-shadow-scheduler");s=p.add_subparsers(dest="cmd",required=True)
 s.add_parser("rank");c=s.add_parser("compare");c.add_argument("--apply",action="store_true")
 a=p.parse_args();db=sqlite3.connect(DB,timeout=30);db.row_factory=sqlite3.Row;db.execute("pragma busy_timeout=30000")
 try:out=score_candidates(db) if a.cmd=="rank" else compare(db,authoritative(),a.apply)
 finally:db.close()
 print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__":main()
