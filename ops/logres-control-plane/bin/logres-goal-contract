#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
LIB = Path(os.environ.get("LOGRES_LIB", str(ROOT / "lib")))
SOURCE_LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))
sys.path.insert(0, str(SOURCE_LIB))

from logres_goal_contract import evaluate_milestone, load_contracts


def integration_sha() -> str:
    override = os.environ.get("LOGRES_INTEGRATION_SHA")
    if override:
        return override.strip()
    repo = Path(
        os.environ.get(
            "LOGRES_REPO",
            str(ROOT / "src" / "awakened-realms"),
        )
    )
    return subprocess.check_output(
        ["git", "-C", str(repo), "rev-parse", "feat/logres-reconstruction"],
        text=True,
    ).strip()


def print_text(result: dict) -> None:
    print(
        f"{result['milestone_id']} {result['state']} "
        f"progress={result['progress_percent']:.2f}% "
        f"sha={result['integration_sha'][:12]} "
        f"contract={result['contract_fingerprint'][:12]}"
    )
    for item in result["criteria"]:
        marker = "PASS" if item["passed"] else item["status"]
        print(
            f"- {item['criterion_id']:34} {marker:18} "
            f"weight={item['weight']:g} {item['reason']}"
        )
    unmet = result.get("unmet_criterion_ids") or []
    print("unmet=" + (",".join(unmet) if unmet else "-"))


def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-goal-contract")
    parser.add_argument(
        "milestone_id",
        nargs="?",
        default="DEMO-0.2",
    )
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--config",
        default=os.environ.get(
            "LOGRES_MILESTONE_CONTRACTS",
            str(ROOT / "config" / "milestone_contracts.json"),
        ),
    )
    parser.add_argument(
        "--db",
        default=os.environ.get(
            "LOGRES_CONTROL_DB",
            str(ROOT / "control" / "control.sqlite"),
        ),
    )
    args = parser.parse_args()

    contracts = load_contracts(Path(args.config))
    conn = sqlite3.connect(args.db)
    conn.row_factory = sqlite3.Row
    try:
        result = evaluate_milestone(
            conn,
            contracts,
            args.milestone_id,
            integration_sha=integration_sha(),
            root=ROOT,
        ).to_dict()
    finally:
        conn.close()

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print_text(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
