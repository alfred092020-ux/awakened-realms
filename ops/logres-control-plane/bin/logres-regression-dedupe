#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_regression_signature import reconcile_semantic_duplicates

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(
    os.environ.get(
        "LOGRES_CONTROL_DB",
        str(ROOT / "control/control.sqlite"),
    )
)


def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-regression-dedupe")
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()

    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma journal_mode=WAL")
    conn.execute("pragma busy_timeout=30000")
    try:
        payload = reconcile_semantic_duplicates(
            conn,
            apply=args.apply,
        )
    finally:
        conn.close()

    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
