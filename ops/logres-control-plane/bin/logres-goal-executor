#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
SOURCE_LIB = CONTROL_ROOT / "lib"
ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
LIB = Path(os.environ.get("LOGRES_LIB", str(ROOT / "lib")))
sys.path.insert(0, str(LIB))
sys.path.insert(0, str(SOURCE_LIB))

from logres_goal_contract import load_contracts
from logres_goal_executor import apply_one, ensure_schema, plan_one


def integration_sha() -> str:
    override = os.environ.get("LOGRES_INTEGRATION_SHA")
    if override:
        return override.strip()
    repo = Path(
        os.environ.get(
            "LOGRES_REPO",
            str(ROOT / "src" / "awakened-realms"),
        )
    )
    return subprocess.check_output(
        ["git", "-C", str(repo), "rev-parse", "feat/logres-reconstruction"],
        text=True,
    ).strip()


def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-goal-executor")
    parser.add_argument("milestone_id", nargs="?", default="DEMO-0.2")
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--config",
        default=os.environ.get(
            "LOGRES_MILESTONE_CONTRACTS",
            str(ROOT / "config" / "milestone_contracts.json"),
        ),
    )
    parser.add_argument(
        "--db",
        default=os.environ.get(
            "LOGRES_CONTROL_DB",
            str(ROOT / "control" / "control.sqlite"),
        ),
    )
    args = parser.parse_args()

    lock_path = Path(
        os.environ.get(
            "LOGRES_GOAL_EXECUTOR_LOCK",
            str(ROOT / "control" / "locks" / "logres-goal-executor.lock"),
        )
    )
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_handle = lock_path.open("a+")
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        payload = {"status": "BUSY", "created": False, "task_id": None}
        print(json.dumps(payload, sort_keys=True))
        return 0

    contracts = load_contracts(Path(args.config))
    conn = sqlite3.connect(args.db, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    ensure_schema(conn)
    try:
        kwargs = {
            "integration_sha": integration_sha(),
            "root": ROOT,
        }
        if args.apply:
            payload = apply_one(
                conn,
                contracts,
                args.milestone_id,
                coordinator=str(ROOT / "bin" / "logres-coordinator"),
                runner=subprocess.run,
                **kwargs,
            )
        else:
            payload = plan_one(
                conn,
                contracts,
                args.milestone_id,
                **kwargs,
            )
            payload["created"] = False
            payload["task_id"] = None
    finally:
        conn.close()
        lock_handle.close()

    payload["status"] = "CREATED" if payload.get("created") else "NOOP"
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        candidate = payload.get("candidate")
        if payload.get("created"):
            print(f"GOAL_EXECUTOR CREATED {payload['task_id']}")
        elif candidate:
            print(
                "GOAL_EXECUTOR WOULD_CREATE "
                + str(candidate.get("task_id") or "-")
            )
        else:
            milestone = payload.get("milestone") or {}
            print(
                "GOAL_EXECUTOR NOOP "
                f"milestone={args.milestone_id} "
                f"state={milestone.get('state','UNKNOWN')}"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
