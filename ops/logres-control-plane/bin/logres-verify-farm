#!/usr/bin/env bash
set -euo pipefail

BASE="${LOGRES_REPO_ROOT:-/home/ubuntu/logres/src/awakened-realms}"
CONTROL="${LOGRES_CONTROL_BIN:-/home/ubuntu/logres/bin/logres-control}"
POOL_BIN="${LOGRES_REMOTE_POOL_BIN:-/home/ubuntu/logres/bin/logres-remote-pool}"
CACHE_BIN="${LOGRES_VERIFY_CACHE_BIN:-/home/ubuntu/logres/bin/logres-verify-cache}"
CONFIG="${LOGRES_AUTOFLOW_CONFIG:-/home/ubuntu/logres/control/autoflow.json}"
REF="${1:-feat/logres-reconstruction}"
ROOT="${LOGRES_VERIFY_ROOT:-/dev/shm/logres}"
PRIVATE_ANCHOR="${LOGRES_PRIVATE_ANCHOR:-/home/ubuntu/logres/private/logres-private-cache.zip}"
STAMP=$(date +%Y%m%dT%H%M%S)
TEST_WT="$ROOT/verify-farm-$STAMP-test"
E2E_WT="$ROOT/verify-farm-$STAMP-e2e"
TEST_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-test.log"
E2E_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-e2e.log"
PERF_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-performance.log"
PERF_CONTROL_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-performance-control.log"
PERF_CONTROL_WT="$ROOT/verify-farm-$STAMP-performance-control"
BEHAVIOR_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-behavior.log"
BEHAVIOR_TRACE_MERGE_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-behavior-trace-merge.log"
BEHAVIOR_TRACE_FAILURE_DIR="${LOGRES_BEHAVIOR_TRACE_FAILURE_DIR:-/home/ubuntu/logres/artifacts/behavior-trace-merge-failures}"
REMOTE_TEST_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-remote-test.log"
VISUAL_TRUTH_MERGE_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-visual-truth-merge.log"
VISUAL_TRUTH_FAILURE_DIR="${LOGRES_VISUAL_TRUTH_FAILURE_DIR:-/home/ubuntu/logres/artifacts/visual-truth-merge-failures}"
CACHE_JSON="/tmp/logres-verify-cache-$STAMP.json"
BEHAVIOR_TRACE_DB="$ROOT/verify-farm-$STAMP-behavior-trace.sqlite"
BEHAVIOR_TRACE_WRAPPER="$ROOT/verify-farm-$STAMP-behavior-trace-recorder"
BEHAVIOR_TRACE_REAL_BIN="${LOGRES_BEHAVIOR_TRACE_BIN:-/home/ubuntu/logres/bin/logres-behavior-trace}"
VISUAL_TRUTH_DB="$ROOT/verify-farm-$STAMP-visual-truth.sqlite"
VISUAL_TRUTH_WRAPPER="$ROOT/verify-farm-$STAMP-visual-truth-recorder"
VISUAL_TRUTH_REAL_BIN="${LOGRES_VISUAL_TRUTH_BIN:-/home/ubuntu/logres/bin/logres-visual-truth}"
CANONICAL_CONTROL_DB="${LOGRES_CANONICAL_CONTROL_DB:-/home/ubuntu/logres/control/control.sqlite}"
BEHAVIOR_TRACE_MERGE_TIMEOUT_MS="${LOGRES_BEHAVIOR_TRACE_MERGE_TIMEOUT_MS:-4000}"
VISUAL_TRUTH_MERGE_TIMEOUT_MS="${LOGRES_VISUAL_TRUTH_MERGE_TIMEOUT_MS:-15000}"
VISUAL_TRUTH_SPOOL_DIR="${LOGRES_VISUAL_TRUTH_SPOOL_DIR:-/home/ubuntu/logres/control/visual-truth-spool}"
CORRECTNESS_BIN="${LOGRES_CORRECTNESS_BIN:-/home/ubuntu/logres/bin/logres-correctness}"
CORRECTNESS_POLICY="${LOGRES_CORRECTNESS_POLICY:-/home/ubuntu/logres/control/correctness_policy.json}"
CORRECTNESS_BASE_REF="${LOGRES_CORRECTNESS_BASE_REF:-origin/feat/logres-reconstruction}"
CORRECTNESS_PLAN="$ROOT/verify-farm-$STAMP-correctness-plan.json"
CORRECTNESS_OUTCOMES="$ROOT/verify-farm-$STAMP-correctness-outcomes.json"
CORRECTNESS_RECEIPT="/home/ubuntu/logres/logs/verify-farm-$STAMP-correctness-receipt.json"
CORRECTNESS_LOG="/home/ubuntu/logres/logs/verify-farm-$STAMP-correctness.log"
START=$(date +%s)
SHA=unknown
VERIFY_PATH="local-test+local-build-e2e"
CACHE_MODE="unit"
CACHE_READY=0
CACHE_ARGS=()
PERF_SPEC_REL="e2e/logres-performance.spec.mjs"
PERF_REQUIRED=0
PERF_MAX_CPU_PSI_AVG10="${LOGRES_PERF_MAX_CPU_PSI_AVG10:-5.0}"
PERF_MAX_LOAD_PER_CPU="${LOGRES_PERF_MAX_LOAD_PER_CPU:-0.70}"
PERF_HOST_SETTLE_ATTEMPTS="${LOGRES_PERF_HOST_SETTLE_ATTEMPTS:-30}"
PERF_HOST_SETTLE_SLEEP_SEC="${LOGRES_PERF_HOST_SETTLE_SLEEP_SEC:-2}"
PERF_HOST_READY_CONSECUTIVE="${LOGRES_PERF_HOST_READY_CONSECUTIVE:-2}"

select_e2e_workers() {
  local override="${LOGRES_E2E_WORKERS:-}"
  if [[ -n "$override" ]]; then
    if [[ ! "$override" =~ ^[1-4]$ ]]; then
      echo "LOGRES_E2E_WORKERS must be an integer from 1 through 4" >&2
      return 2
    fi
    echo "$override"
    return 0
  fi

  local cpus="${LOGRES_CPU_COUNT_OVERRIDE:-}"
  if [[ -z "$cpus" ]]; then
    cpus=$(nproc 2>/dev/null || echo 1)
  fi
  if [[ ! "$cpus" =~ ^[0-9]+$ ]]; then
    cpus=1
  fi
  if (( cpus >= 8 )); then
    echo 3
  else
    echo 1
  fi
}

if [[ "${1:-}" == "--print-e2e-workers" ]]; then
  select_e2e_workers
  exit $?
fi

E2E_WORKERS=$(select_e2e_workers)
E2E_VERIFY_TAG="e2e-w${E2E_WORKERS}"

performance_host_ready() {
  python3 -     "$PERF_MAX_CPU_PSI_AVG10"     "$PERF_MAX_LOAD_PER_CPU"     "$PERF_HOST_SETTLE_ATTEMPTS"     "$PERF_HOST_SETTLE_SLEEP_SEC"     "$PERF_HOST_READY_CONSECUTIVE" <<'PY2'
from pathlib import Path
import os
import re
import sys
import time

psi_limit = float(sys.argv[1])
load_limit = float(sys.argv[2])
attempts = max(1, int(sys.argv[3]))
sleep_sec = max(0.0, float(sys.argv[4]))
required_consecutive = max(1, int(sys.argv[5]))
psi = Path("/proc/pressure/cpu")
consecutive = 0

for attempt in range(1, attempts + 1):
    source = "load"
    value = None
    limit = None

    if psi.is_file():
        text = psi.read_text()
        match = re.search(r"^some .*?avg10=([0-9.]+)", text, re.MULTILINE)
        if match:
            source = "psi_avg10"
            value = float(match.group(1))
            limit = psi_limit

    if value is None:
        load1 = os.getloadavg()[0]
        cpus = os.cpu_count() or 1
        source = "load_per_cpu"
        value = load1 / cpus
        limit = load_limit

    ready = value <= limit
    consecutive = consecutive + 1 if ready else 0

    print(
        f"VERIFY_FARM performance host pressure attempt={attempt}/{attempts} "
        f"{source}={value:.3f} max={limit:.3f} "
        f"ready_streak={consecutive}/{required_consecutive}",
        flush=True,
    )

    if consecutive >= required_consecutive:
        raise SystemExit(0)

    if attempt < attempts:
        time.sleep(sleep_sec)

raise SystemExit(75)
PY2
}

remote_enabled() {
  case "${LOGRES_REMOTE_VERIFY_ENABLED:-}" in
    1|true|TRUE|yes|YES) return 0 ;;
    0|false|FALSE|no|NO) return 1 ;;
  esac
  python3 - "$CONFIG" <<'PY'
import json,sys
try:
    data=json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit(1)
raise SystemExit(
    0 if data.get("remote_pool",{}).get("hybrid_verify_enabled",False) else 1
)
PY
}

remote_available() {
  [[ -x "$POOL_BIN" ]] || return 1
  timeout "${LOGRES_REMOTE_HEALTH_TIMEOUT_SEC:-20}" "$POOL_BIN" status --json     >"/tmp/logres-remote-pool-health-$STAMP.json" 2>/dev/null || return 1
  python3 - "/tmp/logres-remote-pool-health-$STAMP.json" <<'PY'
import json,sys
try:
    rows=json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit(1)
eligible=[
    r for r in rows
    if r.get("reachable") and int(r.get("available_slots",0) or 0)>0
]
raise SystemExit(0 if eligible else 1)
PY
}

prepare_cache_dimensions() {
  CACHE_READY=0
  [[ -x "$CACHE_BIN" ]] || return 0
  [[ -s "$PRIVATE_ANCHOR" ]] || return 0
  git -C "$BASE" cat-file -e "$SHA:package-lock.json" 2>/dev/null || return 0
  git -C "$BASE" cat-file -e "$SHA:package.json" 2>/dev/null || return 0
  git -C "$BASE" cat-file -e "$SHA:tsconfig.json" 2>/dev/null || return 0
  git -C "$BASE" cat-file -e "$SHA:vitest.config.ts" 2>/dev/null || return 0

  local lock_hash config_hash evidence_version env_hash
  lock_hash=$(git -C "$BASE" show "$SHA:package-lock.json" | sha256sum | awk '{print $1}')
  config_hash=$(
    {
      for file in package.json tsconfig.json vitest.config.ts; do
        printf '%s\0' "$file"
        git -C "$BASE" show "$SHA:$file"
      done
    } | sha256sum | awk '{print $1}'
  )
  evidence_version=$(sha256sum "$PRIVATE_ANCHOR" | awk '{print $1}')
  env_hash=$(
    {
      node --version
      npm --version
      uname -srm
    } | sha256sum | awk '{print $1}'
  )
  [[ -n "$lock_hash" && -n "$config_hash" && -n "$evidence_version" && -n "$env_hash" ]] || return 0
  CACHE_ARGS=(
    --source-sha "$SHA"
    --lock-hash "$lock_hash"
    --config-hash "$config_hash"
    --evidence-version "$evidence_version"
    --env-hash "$env_hash"
    --mode "$CACHE_MODE"
  )
  CACHE_READY=1
}

cache_hit() {
  (( CACHE_READY == 1 )) || return 1
  "$CACHE_BIN" get "${CACHE_ARGS[@]}" >"$CACHE_JSON" 2>/dev/null || return 1
  python3 - "$CACHE_JSON" <<'PY'
import json,sys
try:
    payload=json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if payload.get("hit") and payload.get("status") == "PASS" else 1)
PY
}

cache_store_pass() {
  (( CACHE_READY == 1 )) || return 0
  local provenance
  provenance=$(python3 - "$VERIFY_PATH" <<'PY'
import json,sys
print(json.dumps({"producer":"logres-verify-farm","unit_lane":sys.argv[1]}))
PY
)
  "$CACHE_BIN" put-pass "${CACHE_ARGS[@]}" --provenance "$provenance" >/dev/null 2>&1 || true
}

# Full browser verification remains single-flight locally. Remote unit tests do
# not get merge authority and cannot bypass the local private-hydrated E2E gate.
exec 9>/tmp/logres-verify-farm.lock
if ! flock -w "${LOGRES_VERIFY_FARM_WAIT_SEC:-900}" 9; then
  echo "VERIFY_FARM BUSY: timed out waiting for global verification slot" >&2
  exit 75
fi

mkdir -p "$ROOT" /home/ubuntu/logres/logs
SHA=$(git -C "$BASE" rev-parse "$REF")
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || {
  echo "VERIFY_FARM could not pin exact source SHA for $REF" >&2
  exit 2
}

# L0 correctness classification is computed from the committed policy before
# any lane runs, so the receipt can record what the diff required versus what
# executed. A missing oracle or malformed policy fails the farm closed.
if [[ ! -x "$CORRECTNESS_BIN" ]]; then
  echo "VERIFY_FARM correctness oracle missing: $CORRECTNESS_BIN" >&2
  exit 2
fi
if ! "$CORRECTNESS_BIN" plan \
    --repo "$BASE" --sha "$SHA" --ref "$REF" \
    --base "$CORRECTNESS_BASE_REF" --policy "$CORRECTNESS_POLICY" \
    --output "$CORRECTNESS_PLAN" >"$CORRECTNESS_LOG" 2>&1; then
  echo "VERIFY_FARM correctness oracle plan failed closed sha=${SHA:0:12}" >&2
  tail -60 "$CORRECTNESS_LOG" >&2 || true
  exit 2
fi
python3 - "$CORRECTNESS_PLAN" <<'PY'
import json,sys
plan=json.load(open(sys.argv[1]))
print("VERIFY_FARM correctness domains=%s required=%s paths=%s" % (
    ",".join(sorted(plan.get("domains") or ["none"])),
    "+".join(plan.get("required_levels") or []),
    plan.get("path_count")))
PY

if git -C "$BASE" cat-file -e "$SHA:$PERF_SPEC_REL" 2>/dev/null; then
  PERF_REQUIRED=1
  E2E_VERIFY_TAG="${E2E_VERIFY_TAG}+perf-w1"
fi
prepare_cache_dimensions

cleanup() {
  rc=$?
  trap - EXIT INT TERM
  git -C "$BASE" worktree remove --force "$TEST_WT" >/dev/null 2>&1 || true
  git -C "$BASE" worktree remove --force "$E2E_WT" >/dev/null 2>&1 || true
  git -C "$BASE" worktree remove --force "$PERF_CONTROL_WT" >/dev/null 2>&1 || true
  rm -f     "/tmp/logres-remote-pool-health-$STAMP.json"     "$CACHE_JSON"     "$BEHAVIOR_TRACE_DB"     "$BEHAVIOR_TRACE_DB-shm"     "$BEHAVIOR_TRACE_DB-wal"     "$BEHAVIOR_TRACE_WRAPPER"     "$VISUAL_TRUTH_DB"     "$VISUAL_TRUTH_DB-shm"     "$VISUAL_TRUTH_DB-wal"     "$VISUAL_TRUTH_WRAPPER"
  dur=$(( $(date +%s)-START ))
  if (( rc == 75 )); then
    echo "VERIFY_FARM BUSY ref=$REF sha=${SHA:0:12} duration=${dur}s; no verification verdict recorded" >&2
    exit 75
  fi
  status=FAIL; [[ $rc -eq 0 ]] && status=PASS
  "$CONTROL" record-verify "$REF" "$SHA" full-e2e "$status" "$dur"     "verify-farm:$VERIFY_PATH+$E2E_VERIFY_TAG" >/dev/null 2>&1 || true
  exit $rc
}
trap cleanup EXIT INT TERM

prepare_deps() {
  local wt="$1"
  local base_lock ref_lock
  base_lock=$(sha256sum "$BASE/package-lock.json" | awk '{print $1}')
  ref_lock=$(sha256sum "$wt/package-lock.json" | awk '{print $1}')
  if [[ "$base_lock" == "$ref_lock" && -d "$BASE/node_modules" ]]; then
    ln -s "$BASE/node_modules" "$wt/node_modules"
  else
    (cd "$wt" && npm ci --prefer-offline --no-audit --no-fund)
  fi
}

initialize_behavior_trace_isolation() {
  [[ -x "$BEHAVIOR_TRACE_REAL_BIN" ]] || {
    echo "VERIFY_FARM behavior trace recorder missing: $BEHAVIOR_TRACE_REAL_BIN" >&2
    return 1
  }
  [[ "$BEHAVIOR_TRACE_DB" != "$CANONICAL_CONTROL_DB" ]] || {
    echo "VERIFY_FARM isolated behavior trace DB must differ from canonical control DB" >&2
    return 1
  }

  rm -f \
    "$BEHAVIOR_TRACE_DB" \
    "$BEHAVIOR_TRACE_DB-shm" \
    "$BEHAVIOR_TRACE_DB-wal" \
    "$BEHAVIOR_TRACE_WRAPPER"

  {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -euo pipefail'
    printf 'export LOGRES_CONTROL_DB=%q\n' "$BEHAVIOR_TRACE_DB"
    printf 'exec %q "$@"\n' "$BEHAVIOR_TRACE_REAL_BIN"
  } >"$BEHAVIOR_TRACE_WRAPPER"
  chmod 700 "$BEHAVIOR_TRACE_WRAPPER"
}

merge_behavior_trace_isolation() {
  local merger="$E2E_WT/scripts/logres/merge_behavior_trace_records.py"
  [[ -f "$merger" ]] || {
    echo "VERIFY_FARM behavior trace merger missing from exact candidate SHA: $merger" >&2
    return 1
  }
  [[ -s "$BEHAVIOR_TRACE_DB" ]] || {
    echo "VERIFY_FARM isolated behavior trace DB missing after recorder PASS: $BEHAVIOR_TRACE_DB" >&2
    return 1
  }

  python3 "$merger" \
    --source "$BEHAVIOR_TRACE_DB" \
    --target "$CANONICAL_CONTROL_DB" \
    --busy-timeout-ms "$BEHAVIOR_TRACE_MERGE_TIMEOUT_MS" \
    >"$BEHAVIOR_TRACE_MERGE_LOG" 2>&1
}

preserve_behavior_trace_failure() {
  local destination="$BEHAVIOR_TRACE_FAILURE_DIR/$STAMP-${SHA:0:12}.sqlite"
  mkdir -p "$BEHAVIOR_TRACE_FAILURE_DIR"
  python3 - "$BEHAVIOR_TRACE_DB" "$destination" <<'PY'
from pathlib import Path
import sqlite3
import sys

source = Path(sys.argv[1])
destination = Path(sys.argv[2])
if not source.is_file():
    raise SystemExit(2)
destination.parent.mkdir(parents=True, exist_ok=True)
if destination.exists():
    destination.unlink()
src = sqlite3.connect(f"file:{source}?mode=ro", uri=True, timeout=5)
dst = sqlite3.connect(destination, timeout=5)
try:
    src.backup(dst)
    dst.commit()
finally:
    dst.close()
    src.close()
print(destination)
PY
}


initialize_visual_truth_isolation() {
  [[ -x "$VISUAL_TRUTH_REAL_BIN" ]] || {
    echo "VERIFY_FARM visual truth recorder missing: $VISUAL_TRUTH_REAL_BIN" >&2
    return 1
  }
  [[ "$VISUAL_TRUTH_DB" != "$CANONICAL_CONTROL_DB" ]] || {
    echo "VERIFY_FARM isolated visual truth DB must differ from canonical control DB" >&2
    return 1
  }

  rm -f     "$VISUAL_TRUTH_DB"     "$VISUAL_TRUTH_DB-shm"     "$VISUAL_TRUTH_DB-wal"     "$VISUAL_TRUTH_WRAPPER"

  LOGRES_CONTROL_DB="$VISUAL_TRUTH_DB"     "$VISUAL_TRUTH_REAL_BIN" init >/dev/null

  [[ -s "$VISUAL_TRUTH_DB" ]] || {
    echo "VERIFY_FARM failed to initialize isolated visual truth DB: $VISUAL_TRUTH_DB" >&2
    return 1
  }

  {
    printf '%s
' '#!/usr/bin/env bash'
    printf '%s
' 'set -euo pipefail'
    printf 'export LOGRES_CONTROL_DB=%q
' "$VISUAL_TRUTH_DB"
    printf 'exec %q "$@"
' "$VISUAL_TRUTH_REAL_BIN"
  } >"$VISUAL_TRUTH_WRAPPER"
  chmod 700 "$VISUAL_TRUTH_WRAPPER"
}

merge_visual_truth_isolation() {
  local merger="$E2E_WT/scripts/logres/merge_visual_truth_records.py"
  [[ -f "$merger" ]] || {
    echo "VERIFY_FARM visual truth merger missing from exact candidate SHA: $merger" >&2
    return 1
  }

  python3 "$merger"     --source "$VISUAL_TRUTH_DB"     --target "$CANONICAL_CONTROL_DB"     --busy-timeout-ms "$VISUAL_TRUTH_MERGE_TIMEOUT_MS"     --spool-dir "$VISUAL_TRUTH_SPOOL_DIR"     >"$VISUAL_TRUTH_MERGE_LOG" 2>&1
}

preserve_visual_truth_failure() {
  local destination="$VISUAL_TRUTH_FAILURE_DIR/$STAMP-${SHA:0:12}.sqlite"
  mkdir -p "$VISUAL_TRUTH_FAILURE_DIR"
  python3 - "$VISUAL_TRUTH_DB" "$destination" <<'PY'
from pathlib import Path
import sqlite3
import sys

source = Path(sys.argv[1])
destination = Path(sys.argv[2])
if not source.is_file():
    raise SystemExit(2)
destination.parent.mkdir(parents=True, exist_ok=True)
if destination.exists():
    destination.unlink()
src = sqlite3.connect(f"file:{source}?mode=ro", uri=True, timeout=5)
dst = sqlite3.connect(destination, timeout=5)
try:
    src.backup(dst)
    dst.commit()
finally:
    dst.close()
    src.close()
print(destination)
PY
}


hydrate() {
  local wt="$1"
  if [[ -d "$BASE/public/__logres_ref" ]]; then
    mkdir -p "$wt/public/__logres_ref"
    rsync -a "$BASE/public/__logres_ref/" "$wt/public/__logres_ref/"
  fi

  python3 "$wt/scripts/logres/hydrate_live_renderer_proof.py"     --anchor "$PRIVATE_ANCHOR"     --map-id 001_000_00002     --output-root "$wt/public/__logres_ref/renderer-proof"     --summary "$wt/.renderer-proof-hydration.json"

  for required in     "$wt/public/__logres_ref/renderer-proof/002_000_00001/002_000_00001.map.bin"     "$wt/public/__logres_ref/renderer-proof/002_000_00001/002_000_00001_CHIP.png"     "$wt/public/__logres_ref/renderer-proof/002_000_00001/002_000_00001_OBJ.png"     "$wt/public/__logres_ref/renderer-proof/002_000_00001/chip_d.bin"     "$wt/public/__logres_ref/renderer-proof/002_000_00001/object_d.bin"
  do
    [[ -s "$required" ]] || {
      echo "VERIFY_FARM missing required playable runtime: $required" >&2
      return 1
    }
  done

  if [[ -f "$wt/scripts/logres/inspect_avatar_resource_paths.py" ]]; then
    local jp_patch=/home/ubuntu/logres/private/jp-live-patch-cache
    python3 -B "$wt/scripts/logres/inspect_avatar_resource_paths.py"       "$jp_patch"       --output-root "$wt/public/__logres_ref/current-jp/player-avatar-reference"       --summary "$wt/.player-avatar-hydration.json"

    for required in       "$wt/public/__logres_ref/current-jp/player-avatar-reference/player_avatar_reference_m.png"       "$wt/public/__logres_ref/current-jp/player-avatar-reference/player_avatar_reference_f.png"
    do
      [[ -s "$required" ]] || {
        echo "VERIFY_FARM missing required player reference: $required" >&2
        return 1
      }
    done
  fi
}

latest_release_control_sha() {
  python3 - "$CANONICAL_CONTROL_DB" <<'PY2'
import sqlite3
import sys

db = sys.argv[1]
conn = sqlite3.connect(db, timeout=5)
try:
    row = conn.execute(
        """select integration_sha
             from milestone_certificates
            where milestone_id='RELEASE-1.0'
              and status='PASS'
            order by id desc
            limit 1"""
    ).fetchone()
finally:
    conn.close()

if row and isinstance(row[0], str):
    print(row[0])
PY2
}

run_performance_control() {
  local control_sha control_port control_rc
  control_sha=$(latest_release_control_sha)
  if [[ ! "$control_sha" =~ ^[0-9a-f]{40}$ ]]; then
    echo "VERIFY_FARM performance control unavailable: no certified RELEASE-1.0 SHA"       >"$PERF_CONTROL_LOG"
    return 2
  fi

  printf 'VERIFY_FARM performance control sha=%s candidate=%s
'     "$control_sha" "$SHA" >"$PERF_CONTROL_LOG"

  if [[ "$control_sha" == "$SHA" ]]; then
    echo "VERIFY_FARM candidate is the certified release control; timing failure is environmental"       >>"$PERF_CONTROL_LOG"
    return 1
  fi

  git -C "$BASE" worktree remove --force "$PERF_CONTROL_WT" >/dev/null 2>&1 || true
  git -C "$BASE" worktree add --detach "$PERF_CONTROL_WT" "$control_sha"     >>"$PERF_CONTROL_LOG" 2>&1 || return 2
  prepare_deps "$PERF_CONTROL_WT" >>"$PERF_CONTROL_LOG" 2>&1 || return 2
  hydrate "$PERF_CONTROL_WT" >>"$PERF_CONTROL_LOG" 2>&1 || return 2

  control_port=$(python3 - <<'PY2'
import socket
s=socket.socket()
s.bind(("127.0.0.1",0))
print(s.getsockname()[1])
s.close()
PY2
)

  python3 - "$PERF_CONTROL_WT/playwright.config.mjs" "$control_port" <<'PY2'     >>"$PERF_CONTROL_LOG" 2>&1 || return 2
from pathlib import Path
import sys
p=Path(sys.argv[1]); port=sys.argv[2]
s=p.read_text()
s=s.replace("127.0.0.1:4174",f"127.0.0.1:{port}")
s=s.replace("--port 4174",f"--port {port}")
p.write_text(s)
PY2

  (
    set -e
    cd "$PERF_CONTROL_WT"
    npm run build
    env -u LOGRES_VERIFY_SHA       npm run test:e2e -- "$PERF_SPEC_REL" --workers=1
  ) >>"$PERF_CONTROL_LOG" 2>&1
  control_rc=$?

  if (( control_rc == 0 )); then
    echo "VERIFY_FARM certified release control PASS; candidate timing failure is actionable"       >>"$PERF_CONTROL_LOG"
    return 0
  fi

  echo "VERIFY_FARM certified release control FAIL; timing environment is inconclusive"     >>"$PERF_CONTROL_LOG"
  return 1
}

run_local_tests() {
  git -C "$BASE" worktree add --detach "$TEST_WT" "$SHA" >/dev/null
  prepare_deps "$TEST_WT"
  (
    set -e
    hydrate "$TEST_WT"
    cd "$TEST_WT"
    npm run test -- --testTimeout 15000
  ) >"$TEST_LOG" 2>&1
}

# Assemble the run's lane outcomes and ask the deployed correctness oracle to
# evaluate the ladder and emit/persist the exact-SHA receipt. Truth records
# are read from both the isolated farm DBs and the canonical control DB, so
# the receipt is consistent whether merges already ran or not.
run_correctness_evaluate() {
  local phase="$1" behavior_merge="$2" visual_merge="$3"
  mapfile -t receipt_e2e_specs < <(
    cd "$E2E_WT" 2>/dev/null \
      && find e2e -maxdepth 1 -type f -name '*.spec.mjs' \
        ! -name 'logres-performance.spec.mjs' -printf '%f\n' | sort
  )
  python3 - "$CORRECTNESS_OUTCOMES" "$phase" \
    "$VERIFY_PATH" "$E2E_VERIFY_TAG" "$E2E_WORKERS" \
    "$test_rc" "$e2e_rc" "$performance_rc" "$behavior_rc" \
    "$PERF_REQUIRED" "$cache_used" "$remote_used" \
    "$behavior_merge" "$visual_merge" \
    "${receipt_e2e_specs[@]}" <<'PY'
import json,sys
(out_path, phase, verify_path, e2e_tag, e2e_workers, test_rc, e2e_rc,
 perf_rc, behavior_rc, perf_required, cache_used, remote_used,
 behavior_merge, visual_merge, *specs) = sys.argv[1:]
e2e_rc = int(e2e_rc); perf_rc = int(perf_rc); behavior_rc = int(behavior_rc)
test_rc = int(test_rc); perf_required = int(perf_required)
def merge_lane(state):
    return {"pending": {"ran": False, "ok": None},
            "ok": {"ran": True, "ok": True},
            "failed": {"ran": True, "ok": False}}[state]
# An empty spec list means enumeration failed (missing worktree/dir), not that
# the candidate SHA removed every spec; emit null so the oracle treats spec
# evidence as missing rather than reporting every required e2e check skipped.
e2e_specs = list(specs) or None
outcomes = {
  "phase": phase,
  "verify_path": verify_path + "+" + e2e_tag,
  "lanes": {
    "unit": {"ran": True, "rc": test_rc, "path": verify_path,
             "cache_used": cache_used == "1", "remote_used": remote_used == "1"},
    "build": {"ran": True, "rc": e2e_rc,
              "note": "npm run build executes inside the local E2E lane"},
    "e2e": {"ran": True, "rc": e2e_rc, "workers": int(e2e_workers),
            "tag": e2e_tag, "specs": e2e_specs},
    "hydration": {"ran": True, "rc": e2e_rc,
                  "note": "private-anchor hydration precedes the E2E lane"},
    "performance": {"required": bool(perf_required),
                    "ran": bool(perf_required) and e2e_rc == 0,
                    "rc": perf_rc},
    "behavior": {"ran": e2e_rc == 0 and perf_rc == 0, "rc": behavior_rc},
    "merge": {"behavior": merge_lane(behavior_merge),
              "visual": merge_lane(visual_merge)},
  },
}
with open(out_path, "w") as fh:
    json.dump(outcomes, fh, indent=2, sort_keys=True)
PY
  local attest_args=()
  if [[ -n "${LOGRES_CORRECTNESS_ATTESTATION:-}" ]]; then
    attest_args=(--attestation "$LOGRES_CORRECTNESS_ATTESTATION")
  fi
  "$CORRECTNESS_BIN" evaluate \
    --plan "$CORRECTNESS_PLAN" \
    --outcomes "$CORRECTNESS_OUTCOMES" \
    --sha "$SHA" --ref "$REF" \
    --policy "$CORRECTNESS_POLICY" \
    --control-db "$CANONICAL_CONTROL_DB" \
    --aux-db "$BEHAVIOR_TRACE_DB" \
    --aux-db "$VISUAL_TRUTH_DB" \
    --run-id "verify-farm-$STAMP" \
    "${attest_args[@]}" \
    --output "$CORRECTNESS_RECEIPT" >>"$CORRECTNESS_LOG" 2>&1
}

# E2E always stays local and authoritative because it exercises private runtime
# hydration, browser behavior, and the actual playable vertical slice.
git -C "$BASE" worktree add --detach "$E2E_WT" "$SHA" >/dev/null
prepare_deps "$E2E_WT"

E2E_PORT=$(python3 - <<'PY'
import socket
s=socket.socket()
s.bind(("127.0.0.1",0))
print(s.getsockname()[1])
s.close()
PY
)
python3 - "$E2E_WT/playwright.config.mjs" "$E2E_PORT" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); port=sys.argv[2]
s=p.read_text()
s=s.replace("127.0.0.1:4174",f"127.0.0.1:{port}")
s=s.replace("--port 4174",f"--port {port}")
p.write_text(s)
PY

initialize_behavior_trace_isolation
initialize_visual_truth_isolation

export PLAYWRIGHT_BROWSERS_PATH=/home/ubuntu/logres/cache/playwright
export LOGRES_VERIFY_SHA="$SHA"
export LOGRES_RECORD_VISUAL_TRUTH=1
export LOGRES_REQUIRE_VISUAL_TRUTH_RECORD=1
export LOGRES_VISUAL_TRUTH_BIN="$VISUAL_TRUTH_WRAPPER"
export LOGRES_BEHAVIOR_TRACE_OUT="$E2E_WT/.logres-behavior-trace.json"
export LOGRES_BEHAVIOR_TRACE_BIN="$BEHAVIOR_TRACE_WRAPPER"
(
  set -e
  hydrate "$E2E_WT"
  cd "$E2E_WT"
  npm run build

  mapfile -t shared_e2e_specs < <(
    find e2e -maxdepth 1 -type f -name '*.spec.mjs'       ! -name 'logres-performance.spec.mjs'       -print | sort
  )
  if (( ${#shared_e2e_specs[@]} == 0 )); then
    echo "VERIFY_FARM shared E2E spec set is empty" >&2
    exit 2
  fi

  npm run test:e2e -- "${shared_e2e_specs[@]}" --workers="$E2E_WORKERS"
) >"$E2E_LOG" 2>&1 &
e2e_pid=$!

remote_pid=""
remote_used=0
cache_used=0
test_rc=0

if cache_hit; then
  cache_used=1
  VERIFY_PATH="cache-test+local-build-e2e"
  printf 'VERIFY_FARM unit cache HIT sha=%s mode=%s\n' "${SHA:0:12}" "$CACHE_MODE" >"$TEST_LOG"
  echo "VERIFY_FARM exact-key unit-test cache HIT sha=${SHA:0:12}"
else
  if remote_enabled && remote_available; then
    remote_used=1
    job="verify-${STAMP}-${SHA:0:12}"
    (
      timeout "${LOGRES_REMOTE_VERIFY_TIMEOUT_SEC:-240}"       "$POOL_BIN" run auto "$job" test "$SHA" --reassignable --retries 1
    ) >"$REMOTE_TEST_LOG" 2>&1 &
    remote_pid=$!
    echo "VERIFY_FARM adaptive remote unit-test lane started sha=${SHA:0:12}"
  fi

  if (( remote_used == 1 )); then
    if wait "$remote_pid"; then
      VERIFY_PATH="remote-test+local-build-e2e"
      cp "$REMOTE_TEST_LOG" "$TEST_LOG"
      echo "VERIFY_FARM remote unit-test lane PASS"
    else
      echo "VERIFY_FARM remote unit-test lane unavailable/failed; falling back locally" >&2
      if run_local_tests; then
        VERIFY_PATH="remote-fallback-local-test+local-build-e2e"
      else
        test_rc=$?
      fi
    fi
  else
    if run_local_tests; then
      VERIFY_PATH="local-test+local-build-e2e"
    else
      test_rc=$?
    fi
  fi

  if (( test_rc == 0 )); then
    cache_store_pass
  fi
fi

e2e_rc=0
wait "$e2e_pid" || e2e_rc=$?

performance_rc=0
if (( e2e_rc == 0 && PERF_REQUIRED == 1 )); then
  host_rc=0
  performance_host_ready >"$PERF_LOG" 2>&1 || host_rc=$?
  if (( host_rc == 75 )); then
    performance_rc=75
  elif (( host_rc != 0 )); then
    performance_rc=$host_rc
  else
    (
      set -e
      cd "$E2E_WT"
      npm run test:e2e -- "$PERF_SPEC_REL" --workers=1
    ) >>"$PERF_LOG" 2>&1 || performance_rc=$?

    if (( performance_rc != 0 )); then
      control_rc=0
      run_performance_control || control_rc=$?
      if (( control_rc == 1 )); then
        echo "VERIFY_FARM candidate timing failed and certified release control also failed"           >>"$PERF_LOG"
        performance_rc=75
      elif (( control_rc == 2 )); then
        echo "VERIFY_FARM certified release control unavailable; preserving candidate failure"           >>"$PERF_LOG"
      fi
    fi
  fi
else
  printf 'VERIFY_FARM isolated performance lane not required-or-shared-e2e-failed sha=%s e2e_rc=%s required=%s
'     "$SHA" "$e2e_rc" "$PERF_REQUIRED" >"$PERF_LOG"
fi

if (( performance_rc == 75 )); then
  echo "VERIFY_FARM BUSY performance host contention sha=${SHA:0:12}" >&2
  tail -40 "$PERF_LOG" >&2 || true
  echo "--- certified release performance control ---" >&2
  tail -80 "$PERF_CONTROL_LOG" >&2 || true
  exit 75
fi

behavior_rc=0
if (( e2e_rc == 0 && performance_rc == 0 )); then
  python3 "$E2E_WT/scripts/logres/verify_behavior_checkpoint.py" \
    --observed "$LOGRES_BEHAVIOR_TRACE_OUT" \
    --sha "$SHA" \
    --recorder "$LOGRES_BEHAVIOR_TRACE_BIN" \
    >"$BEHAVIOR_LOG" 2>&1 || behavior_rc=$?
fi

if (( test_rc != 0 || e2e_rc != 0 || performance_rc != 0 || behavior_rc != 0 )); then
  echo "VERIFY_FARM FAIL test_rc=$test_rc e2e_rc=$e2e_rc performance_rc=$performance_rc behavior_rc=$behavior_rc path=$VERIFY_PATH" >&2
  echo "--- test tail ---" >&2
  tail -80 "$TEST_LOG" >&2 || true
  echo "--- e2e tail ---" >&2
  tail -120 "$E2E_LOG" >&2 || true
  echo "--- isolated performance tail ---" >&2
  tail -120 "$PERF_LOG" >&2 || true
  echo "--- behavior tail ---" >&2
  tail -120 "$BEHAVIOR_LOG" >&2 || true
  /home/ubuntu/logres/bin/logres-regression-capture     --kind candidate-verify     --ref "$REF"     --sha "$SHA"     --summary "verify-farm test_rc=$test_rc e2e_rc=$e2e_rc performance_rc=$performance_rc behavior_rc=$behavior_rc path=$VERIFY_PATH+$E2E_VERIFY_TAG"     --log "$TEST_LOG"     --log "$E2E_LOG" --log "$PERF_LOG" --log "$BEHAVIOR_LOG" >/dev/null 2>&1 || true
  run_correctness_evaluate lanes pending pending || true
  echo "correctness_receipt=$CORRECTNESS_RECEIPT" >&2 || true
  exit 1
fi

if ! merge_behavior_trace_isolation; then
  echo "VERIFY_FARM FAIL behavior trace merge failed closed sha=${SHA:0:12}" >&2
  preserved_behavior_trace=""
  preserved_behavior_trace=$(preserve_behavior_trace_failure 2>/dev/null || true)
  if [[ -n "$preserved_behavior_trace" ]]; then
    printf 'preserved_isolated_behavior_trace=%s\n' "$preserved_behavior_trace" \
      >>"$BEHAVIOR_TRACE_MERGE_LOG"
    echo "VERIFY_FARM preserved isolated behavior trace: $preserved_behavior_trace" >&2
  fi
  echo "--- behavior trace merge tail ---" >&2
  tail -120 "$BEHAVIOR_TRACE_MERGE_LOG" >&2 || true
  /home/ubuntu/logres/bin/logres-regression-capture \
    --kind candidate-verify \
    --ref "$REF" \
    --sha "$SHA" \
    --summary "behavior-trace isolated merge failed after successful E2E" \
    --log "$BEHAVIOR_TRACE_MERGE_LOG" >/dev/null 2>&1 || true
  run_correctness_evaluate lanes failed pending || true
  exit 1
fi

if ! merge_visual_truth_isolation; then
  echo "VERIFY_FARM FAIL visual truth merge failed closed sha=${SHA:0:12}" >&2
  preserved_visual_truth=""
  preserved_visual_truth=$(preserve_visual_truth_failure 2>/dev/null || true)
  if [[ -n "$preserved_visual_truth" ]]; then
    printf 'preserved_isolated_visual_truth=%s\n' "$preserved_visual_truth"       >>"$VISUAL_TRUTH_MERGE_LOG"
    echo "VERIFY_FARM preserved isolated visual truth: $preserved_visual_truth" >&2
  fi
  echo "--- visual truth merge tail ---" >&2
  tail -120 "$VISUAL_TRUTH_MERGE_LOG" >&2 || true
  /home/ubuntu/logres/bin/logres-regression-capture     --kind candidate-verify     --ref "$REF"     --sha "$SHA"     --summary "visual-truth isolated merge failed after successful E2E"     --log "$VISUAL_TRUTH_MERGE_LOG" >/dev/null 2>&1 || true
  run_correctness_evaluate lanes ok failed || true
  exit 1
fi

# The correctness oracle emits the machine-readable exact-SHA receipt last so
# it records every lane, both truth merges, all skips, blocking failures and
# unresolved evidence ceilings. Its verdict gates promotion, never the farm's
# own machinery (evaluator self-changes require independent verification).
correctness_rc=0
run_correctness_evaluate complete ok ok || correctness_rc=$?
case "$correctness_rc" in
  0)
    ;;
  3)
    echo "VERIFY_FARM BLOCKED correctness ladder requires L3 review/independent verification sha=${SHA:0:12}" >&2
    echo "correctness_receipt=$CORRECTNESS_RECEIPT" >&2
    tail -60 "$CORRECTNESS_LOG" >&2 || true
    exit 1
    ;;
  2)
    echo "VERIFY_FARM correctness oracle failed closed sha=${SHA:0:12}" >&2
    tail -60 "$CORRECTNESS_LOG" >&2 || true
    exit 2
    ;;
  *)
    echo "VERIFY_FARM FAIL correctness ladder verdict sha=${SHA:0:12}" >&2
    tail -80 "$CORRECTNESS_LOG" >&2 || true
    /home/ubuntu/logres/bin/logres-regression-capture \
      --kind candidate-verify \
      --ref "$REF" \
      --sha "$SHA" \
      --summary "correctness ladder FAIL at exact SHA $SHA" \
      --log "$CORRECTNESS_LOG" >/dev/null 2>&1 || true
    exit 1
    ;;
esac

dur=$(( $(date +%s)-START ))
echo "VERIFY_FARM PASS ref=$REF sha=$SHA duration=${dur}s path=$VERIFY_PATH+$E2E_VERIFY_TAG+behavior-truth"
echo "test_log=$TEST_LOG"
echo "e2e_log=$E2E_LOG"
echo "performance_log=$PERF_LOG"
echo "performance_control_log=$PERF_CONTROL_LOG"
echo "behavior_log=$BEHAVIOR_LOG"
echo "behavior_trace_merge_log=$BEHAVIOR_TRACE_MERGE_LOG"
echo "visual_truth_merge_log=$VISUAL_TRUTH_MERGE_LOG"
echo "correctness_log=$CORRECTNESS_LOG"
echo "correctness_receipt=$CORRECTNESS_RECEIPT"
