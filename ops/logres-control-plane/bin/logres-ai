#!/home/ubuntu/logres/envs/research/bin/python
import argparse
import json
import sqlite3
import subprocess
import sys
from pathlib import Path

from openai import OpenAI

sys.path.insert(0, "/home/ubuntu/logres/lib")
from logres_ai_common import brain_post_dedupe_key
from logres_ai_runner import analyze_artifact, cli_summary

DB = Path("/home/ubuntu/logres/control/control.sqlite")
RESULTS = Path("/home/ubuntu/logres/control/ai-results")
CONFIG = Path("/home/ubuntu/logres/control/autoflow.json")
BRAIN = "/home/ubuntu/logres/bin/logres-brain"

ap = argparse.ArgumentParser(prog="logres-ai")
ap.add_argument("artifact")
ap.add_argument("--task")
ap.add_argument("--question", default="Extract material Logres findings, contradictions, unresolved points, and the highest-value next search.")
ap.add_argument("--post-brain", action="store_true")
ap.add_argument("--force", action="store_true")
ap.add_argument("--route-job-id", type=int)
args = ap.parse_args()

if not Path(args.artifact).is_file():
    raise SystemExit(f"artifact not found: {args.artifact}")

client = OpenAI()
config = {}
if CONFIG.is_file():
    try:
        config = json.loads(CONFIG.read_text())
    except (OSError, json.JSONDecodeError):
        config = {}
rate_config = config.get("openai", {}).get("model_rates_per_million", {})

conn = sqlite3.connect(DB)
out = analyze_artifact(
    client,
    conn,
    Path(args.artifact),
    args.question,
    task_id=args.task,
    force=args.force,
    route_job_id=args.route_job_id,
    rate_config=rate_config,
)
conn.close()

RESULTS.mkdir(parents=True, exist_ok=True)
result_path = RESULTS / f"{out['artifact_sha'][:16]}.json"
result_path.write_text(json.dumps(out, indent=2, ensure_ascii=False))

if args.post_brain:
    subprocess.run([BRAIN, "join", "ai", "--name", "Logres AI Worker"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    body = json.dumps(out["result"], separators=(",", ":"), ensure_ascii=False)
    if len(body) > 7600:
        body = body[:7600] + "..."
    subject = f"AI analysis: {Path(args.artifact).name} [{out['result']['confidence']}]"
    cmd = [
        BRAIN, "post", "ai", "ALL", "EVIDENCE", "NORMAL", subject,
        "--body", body,
        "--dedupe", brain_post_dedupe_key(out["artifact_sha"], args.question),
    ]
    if args.task:
        cmd += ["--task", args.task]
    subprocess.run(cmd, check=True)

print(json.dumps(cli_summary(out, result_path), indent=2, ensure_ascii=False))
