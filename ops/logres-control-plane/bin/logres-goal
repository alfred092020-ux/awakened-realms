#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(CONTROL_ROOT / "lib"))

from logres_goal import (
    active_milestones,
    ensure_schema,
    plan_milestone,
    portfolio,
    watch_milestone,
)

ROOT = Path(os.environ.get("LOGRES_ROOT", "/home/ubuntu/logres"))
DB = Path(
    os.environ.get(
        "LOGRES_CONTROL_DB",
        str(ROOT / "control/control.sqlite"),
    )
)
BRAIN = str(ROOT / "bin/logres-brain")


def connect() -> sqlite3.Connection:
    conn = sqlite3.connect(DB, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("pragma busy_timeout=30000")
    ensure_schema(conn)
    return conn


def post_change(result: dict) -> None:
    if not result.get("changed"):
        return
    plan = result["plan"]
    state = plan["state"]
    priority = "HIGH" if state in {"COMPLETE", "WAITING_EXTERNAL"} else "NORMAL"
    subject = f"Goal state: {plan['milestone_id']} -> {state}"
    next_ids = ", ".join(
        item["task_id"] for item in plan.get("next_actions", [])[:5]
    ) or "none"
    blockers = ", ".join(
        item["task_id"] for item in plan.get("external_blockers", [])[:5]
    ) or "none"
    body = (
        f"progress={plan['progress_percent']}% "
        f"previous={result.get('previous_state') or 'none'} "
        f"next={next_ids} external_blockers={blockers}. "
        "Goal watchdog is descriptive only; it does not invent work or "
        "override evidence ceilings."
    )
    subprocess.run(
        [
            BRAIN,
            "post",
            "system",
            "lead",
            "INFO",
            priority,
            subject,
            "--body",
            body,
            "--dedupe",
            f"goal:{plan['milestone_id']}:{plan['fingerprint']}",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def main() -> int:
    ap = argparse.ArgumentParser(prog="logres-goal")
    sub = ap.add_subparsers(dest="command", required=True)

    milestone = sub.add_parser("milestone")
    milestone.add_argument("milestone_id")

    sub.add_parser("portfolio")

    watch = sub.add_parser("watch")
    watch.add_argument("milestone_id")
    watch.add_argument("--apply", action="store_true")

    active = sub.add_parser("watch-active")
    active.add_argument("--apply", action="store_true")

    args = ap.parse_args()
    conn = connect()
    try:
        if args.command == "milestone":
            payload = plan_milestone(conn, args.milestone_id).to_dict()
        elif args.command == "portfolio":
            payload = portfolio(conn)
        elif args.command == "watch":
            payload = watch_milestone(
                conn,
                args.milestone_id,
                apply=args.apply,
            )
            if args.apply:
                post_change(payload)
        else:
            results = []
            for milestone_id in active_milestones(conn):
                result = watch_milestone(
                    conn,
                    milestone_id,
                    apply=args.apply,
                )
                if args.apply:
                    post_change(result)
                results.append(result)
            payload = {"results": results}
    finally:
        conn.close()

    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
