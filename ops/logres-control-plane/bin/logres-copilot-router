#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

CONTROL_ROOT = Path(__file__).resolve().parents[1]
LIB_DIR = CONTROL_ROOT / "lib"
sys.path.insert(0, str(LIB_DIR))

from logres_autonomy import rank_ready_tasks
from logres_copilot import PolicyError, SubprocessGitHubRunner
from logres_copilot_router import (
    SubprocessCommandRunner,
    active_copilot_jobs,
    copilot_eligibility,
    dispatch_task,
    reconcile_copilot_job,
)
from logres_route_store import ensure_route_schema


DEFAULT_DB = Path("/home/ubuntu/logres/control/control.sqlite")
DEFAULT_CONFIG = Path("/home/ubuntu/logres/control/autoflow.json")
DEFAULT_CONFIG_FALLBACK = CONTROL_ROOT / "config" / "autoflow.default.json"


def load_config() -> dict:
    configured = Path(os.environ.get("LOGRES_AUTOFLOW_CONFIG", str(DEFAULT_CONFIG)))
    source = configured if configured.is_file() else DEFAULT_CONFIG_FALLBACK
    if not source.is_file():
        return {}
    return json.loads(source.read_text())


def integration_sha() -> str:
    forced = os.environ.get("LOGRES_INTEGRATION_SHA", "").strip()
    if forced:
        return forced
    result = subprocess.run(
        ["git", "-C", "/home/ubuntu/logres/src/awakened-realms",
         "rev-parse", "origin/feat/logres-reconstruction"],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def candidate_ids(conn: sqlite3.Connection, task_id: str | None, limit: int) -> list[str]:
    if task_id:
        return [task_id]
    return rank_ready_tasks(conn, limit=max(1, limit))


def main() -> int:
    parser = argparse.ArgumentParser(prog="logres-copilot-router")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--task")
    parser.add_argument("--limit", type=int, default=1)
    parser.add_argument("--reconcile-only", action="store_true")
    args = parser.parse_args()

    db_path = Path(os.environ.get("LOGRES_CONTROL_DB", str(DEFAULT_DB)))
    config = load_config()
    sha = integration_sha()
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    ensure_route_schema(conn)

    max_dispatch = max(1, args.limit)
    scan_limit = 1 if args.task else max(16, max_dispatch * 4)
    ids = candidate_ids(conn, args.task, scan_limit)
    dispatch_enabled = bool(
        config.get("routing", {}).get("copilot_dispatch_enabled", False)
    )

    if args.dry_run:
        rows = []
        for task_id in ids:
            eligibility = copilot_eligibility(conn, task_id, sha, config)
            rows.append(
                {
                    "dry_run": True,
                    "task_id": task_id,
                    "eligible": eligibility.allowed,
                    "reason": eligibility.reason,
                    "dispatch_enabled": dispatch_enabled,
                    "integration_sha": sha,
                }
            )
        conn.close()
        if args.task or len(rows) == 1:
            print(json.dumps(rows[0] if rows else {}, indent=2))
        else:
            print(json.dumps({"dry_run": True, "candidates": rows}, indent=2))
        return 0

    github = SubprocessGitHubRunner()
    commands = SubprocessCommandRunner()
    reconciled = []
    for job in active_copilot_jobs(conn):
        result = reconcile_copilot_job(
            job,
            gh_runner=github,
            command_runner=commands,
            current_integration_sha=sha,
            conn=conn,
        )
        reconciled.append(
            {
                "task_id": result.task_id,
                "route_job_id": result.route_job_id,
                "branch": result.branch,
                "candidate_sha": result.candidate_sha,
                "state": result.state,
                "revalidation_required": result.revalidation_required,
            }
        )

    if args.reconcile_only or not dispatch_enabled:
        conn.close()
        print(
            json.dumps(
                {
                    "reconciled": reconciled,
                    "dispatched": 0,
                    "dispatch_enabled": dispatch_enabled,
                    "reason": "reconcile-only" if args.reconcile_only else "dispatch disabled",
                },
                indent=2,
            )
        )
        return 0

    if not ids:
        conn.close()
        print(json.dumps({"reconciled": reconciled, "dispatched": 0, "reason": "no READY tasks"}))
        return 0

    results = []
    skipped = []
    for task_id in ids:
        if len(results) >= max_dispatch:
            break
        eligibility = copilot_eligibility(
            conn,
            task_id,
            sha,
            config,
        )
        if not eligibility.allowed:
            skipped.append(
                {
                    "task_id": task_id,
                    "reason": eligibility.reason,
                }
            )
            continue
        try:
            result = dispatch_task(
                conn,
                task_id,
                sha,
                config,
                github,
            )
        except PolicyError as exc:
            # Eligibility can change between ranking and dispatch if another
            # worker/route acquires overlapping capacity. Skip safely and keep
            # scanning instead of aborting the whole autonomous cycle.
            skipped.append(
                {
                    "task_id": task_id,
                    "reason": str(exc),
                }
            )
            continue
        results.append(
            {
                "task_id": task_id,
                "route_job_id": result.route_job_id,
                "copilot_job_id": result.job.id,
                "issue_number": result.job.issue_number,
                "branch": result.branch,
                "state": result.job.state,
            }
        )
    conn.close()
    print(
        json.dumps(
            {
                "reconciled": reconciled,
                "dispatched": len(results),
                "jobs": results,
                "skipped": skipped,
                "scanned": len(ids),
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
