#!/usr/bin/env python3
import argparse,json,os,sqlite3,sys
from pathlib import Path
ROOT=Path(os.environ.get("LOGRES_ROOT","/home/ubuntu/logres"));sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"lib"))
from logres_health_confidence import record,subsystem,summary
DB=Path(os.environ.get("LOGRES_CONTROL_DB",ROOT/"control/control.sqlite"))
def main():
 p=argparse.ArgumentParser(prog="logres-health-confidence");s=p.add_subparsers(dest="cmd",required=True)
 r=s.add_parser("record");r.add_argument("subsystem");r.add_argument("source");r.add_argument("status");r.add_argument("--confidence",type=float,default=1.0);r.add_argument("--metadata",default="{}")
 q=s.add_parser("subsystem");q.add_argument("subsystem");q.add_argument("--half-life",type=float,default=900)
 sm=s.add_parser("summary");sm.add_argument("--half-life",type=float,default=900)
 a=p.parse_args();c=sqlite3.connect(DB,timeout=30);c.row_factory=sqlite3.Row;c.execute("pragma busy_timeout=30000")
 try:
  if a.cmd=="record":out={"id":record(c,a.subsystem,a.source,a.status,a.confidence,metadata=json.loads(a.metadata))}
  elif a.cmd=="subsystem":out=subsystem(c,a.subsystem,half_life_seconds=a.half_life)
  else:out=summary(c,half_life_seconds=a.half_life)
 finally:c.close()
 print(json.dumps(out,indent=2,sort_keys=True))
if __name__=="__main__":main()
